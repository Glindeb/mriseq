\tl_new:N \l__mriseq_kp_adc_tl
\tl_new:N \l__mriseq_kp_jump_tl
\tl_new:N \l__mriseq_kp_last_tl
\fp_new:N \l__mriseq_kp_lastt_fp
\cs_new_protected:Npn \__mriseq_kp_geometry:
  {
    \fp_set:Nn \l__mriseq_kp_s_fp
      { \dim_to_decimal_in_unit:nn { \l__mriseq_kspace_size_dim } { 1cm } }
    \str_if_eq:VnTF \l__mriseq_kspace_tl { left }
      {
        \fp_set:Nn \l__mriseq_kp_x_fp
          { \l__mriseq_xlab_fp - \dim_to_decimal_in_unit:nn { \l__mriseq_kspace_gap_dim } { 1cm }
            - \l__mriseq_kp_s_fp / 2 }
      }
      {
        \fp_set:Nn \l__mriseq_kp_x_fp
          { \l__mriseq_width_fp + \dim_to_decimal_in_unit:nn { \l__mriseq_kspace_gap_dim } { 1cm }
            + \l__mriseq_kp_s_fp / 2 }
      }
    \fp_set:Nn \l__mriseq_kp_y_fp { \l__mriseq_ybot_fp / 2 }
    \str_if_eq:VnT \l__mriseq_kspace_tl { below }
      {
        \fp_set:Nn \l__mriseq_kp_x_fp { \l__mriseq_width_fp / 2 }
        \fp_set:Nn \l__mriseq_kp_y_fp
          {
            \l__mriseq_yaxis_fp
            - \bool_if:NTF \l__mriseq_ticks_bool { 0.45 } { \bool_if:NTF \l__mriseq_axis_bool { 0.35 } { 0 } }
            - \g__mriseq_botlevels_int * \dim_to_decimal_in_unit:nn { \l__mriseq_intervalsep_dim } { 1cm }
            - \dim_to_decimal_in_unit:nn { \l__mriseq_kspace_gap_dim } { 1cm }
            - \tl_if_blank:VTF \l__mriseq_kspace_title_tl { 0 } { 0.35 }
            - \l__mriseq_kp_s_fp / 2
          }
      }
    \fp_set:Nn \l__mriseq_kp_m_fp { max( \g__mriseq_k_maxx_fp , 1e-9 ) }
    \fp_set:Nn \l__mriseq_kp_my_fp { max( \g__mriseq_k_maxy_fp , 1e-9 ) }
    \bool_if:NT \l__mriseq_kspace_iso_bool
      {
        \fp_set:Nn \l__mriseq_kp_m_fp { max( \l__mriseq_kp_m_fp , \l__mriseq_kp_my_fp ) }
        \fp_set_eq:NN \l__mriseq_kp_my_fp \l__mriseq_kp_m_fp
      }
  }
\cs_new:Npn \__mriseq_kp_pt:nn #1#2
  {
    ( \fp_eval:n { round( \l__mriseq_kp_x_fp + (#1) / \l__mriseq_kp_m_fp * 0.42 * \l__mriseq_kp_s_fp , 4 ) } cm ,
      \fp_eval:n { round( \l__mriseq_kp_y_fp + (#2) / \l__mriseq_kp_my_fp * 0.43 * \l__mriseq_kp_s_fp , 4 ) } cm )
  }
\cs_new_protected:Npn \__mriseq_draw_kspace:
  {
    \str_if_eq:VnF \l__mriseq_kspace_tl { none }
      {
        \__mriseq_kp_geometry:
        \tl_clear:N \l__mriseq_kp_line_tl
        \tl_clear:N \l__mriseq_kp_adc_tl
        \tl_clear:N \l__mriseq_kp_jump_tl
        \tl_clear:N \l__mriseq_kp_last_tl
        \tl_map_tokens:Nn \g__mriseq_k_panel_tl { \__mriseq_kp_segment:n }
        \fp_set:Nn \l__mriseq_tmpa_fp { 0.5 * \l__mriseq_kp_s_fp }
        \__mriseq_exec:e
          {
            % centre axes, trajectory, frame, labels
            \exp_not:N \draw [ mriseq/kspace~axes ]
              ( \fp_eval:n { \l__mriseq_kp_x_fp - \l__mriseq_tmpa_fp } cm , \fp_eval:n { \l__mriseq_kp_y_fp } cm ) --
              ( \fp_eval:n { \l__mriseq_kp_x_fp + \l__mriseq_tmpa_fp } cm , \fp_eval:n { \l__mriseq_kp_y_fp } cm )
              ( \fp_eval:n { \l__mriseq_kp_x_fp } cm , \fp_eval:n { \l__mriseq_kp_y_fp - \l__mriseq_tmpa_fp } cm ) --
              ( \fp_eval:n { \l__mriseq_kp_x_fp } cm , \fp_eval:n { \l__mriseq_kp_y_fp + \l__mriseq_tmpa_fp } cm ) ;
            \tl_if_blank:VF \l__mriseq_kp_jump_tl
              { \exp_not:N \draw [ mriseq/kspace~jump ] \exp_not:V \l__mriseq_kp_jump_tl ; }
            \tl_if_blank:VF \l__mriseq_kp_line_tl
              { \exp_not:N \draw [ mriseq/kspace~path ] \exp_not:V \l__mriseq_kp_line_tl ; }
            \tl_if_blank:VF \l__mriseq_kp_adc_tl
              { \exp_not:N \draw [ mriseq/kspace~adc ] \exp_not:V \l__mriseq_kp_adc_tl ; }
            \exp_not:N \fill [ mriseq/kspace~origin ] \__mriseq_kp_pt:nn { 0 } { 0 } circle [ radius = 1.1pt ] ;
            \exp_not:N \draw [ mriseq/kspace~frame ]
              ( \fp_eval:n { \l__mriseq_kp_x_fp - \l__mriseq_tmpa_fp } cm , \fp_eval:n { \l__mriseq_kp_y_fp - \l__mriseq_tmpa_fp } cm )
              rectangle
              ( \fp_eval:n { \l__mriseq_kp_x_fp + \l__mriseq_tmpa_fp } cm , \fp_eval:n { \l__mriseq_kp_y_fp + \l__mriseq_tmpa_fp } cm ) ;
            \exp_not:N \node [ mriseq/kspace~label , anchor = north ]
              at ( \fp_eval:n { \l__mriseq_kp_x_fp } cm , \fp_eval:n { \l__mriseq_kp_y_fp - \l__mriseq_tmpa_fp } cm )
              { \exp_not:N \ensuremath { k \c_math_subscript_token x } } ;
            \exp_not:N \node [ mriseq/kspace~label , anchor = east ]
              at ( \fp_eval:n { \l__mriseq_kp_x_fp - \l__mriseq_tmpa_fp } cm , \fp_eval:n { \l__mriseq_kp_y_fp } cm )
              { \exp_not:N \ensuremath { k \c_math_subscript_token y } } ;
            \tl_if_blank:VF \l__mriseq_kspace_title_tl
              {
                \exp_not:N \node [ mriseq/kspace~title , anchor = south ]
                  at ( \fp_eval:n { \l__mriseq_kp_x_fp } cm , \fp_eval:n { \l__mriseq_kp_y_fp + \l__mriseq_tmpa_fp } cm )
                  { \exp_not:V \l__mriseq_kspace_title_tl } ;
              }
          }
      }
  }
\cs_new_protected:Npn \__mriseq_kp_segment:n #1 { \__mriseq_kp_segment:nnnnnnn #1 }
\cs_new_protected:Npn \__mriseq_kp_segment:nnnnnnn #1#2#3#4#5#6#7
  {
    % only the part of the trajectory inside the time window
    \bool_lazy_and:nnT
      { \fp_compare_p:nNn {#2} > { \l__mriseq_tmin_fp - 1e-7 } }
      { \fp_compare_p:nNn {#3} < { \l__mriseq_tmax_fp + 1e-7 } }
      {
        \bool_lazy_and:nnTF
          { \str_if_eq_p:Vn \l__mriseq_kp_last_tl {#1} }
          { \fp_compare_p:nNn { abs( \l__mriseq_kp_lastt_fp - (#2) ) } < { 1e-6 } }
          { \tl_put_right:ce { l__mriseq_kp_#1_tl } { -- \__mriseq_kp_pt:nn {#6} {#7} } }
          { \tl_put_right:ce { l__mriseq_kp_#1_tl } { \__mriseq_kp_pt:nn {#4} {#5} -- \__mriseq_kp_pt:nn {#6} {#7} } }
        \tl_set:Nn \l__mriseq_kp_last_tl {#1}
        \fp_set:Nn \l__mriseq_kp_lastt_fp {#3}
      }
  }

\cs_new_protected:Npn \__mriseq_end:
  {
    \unskip
    % everything (also the computation) happens inside the picture, so that
    % TikZ externalisation can skip it for cached figures
    \__mriseq_exec:e
      { \exp_not:N \begin{tikzpicture} [ \exp_not:V \l__mriseq_tikz_tl ] }

    % ---- measure
    \bool_gset_false:N \g__mriseq_any_bool
    \bool_gset_false:N \g__mriseq_markerlabel_bool
    \int_gzero:N \g__mriseq_toplevels_int
    \int_gzero:N \g__mriseq_botlevels_int
    \fp_gset:Nn \g__mriseq_tfirst_fp { inf }
    \fp_gset:Nn \g__mriseq_tlast_fp { -inf }
    \prop_gclear:N \g__mriseq_max_prop
    \seq_gclear:N \g__mriseq_occ_seq
    \seq_gclear:N \g__mriseq_gaps_seq
    \cs_set_eq:NN \__mriseq_item:nnn \__mriseq_measure_item:nnn
    \g__mriseq_items_tl
    \bool_if:NF \l__mriseq_markers_bool { \bool_gset_false:N \g__mriseq_markerlabel_bool }
    % ---- k-space
    \bool_set:Nn \l__mriseq_k_needed_bool
      { ! \str_if_eq_p:Vn \l__mriseq_kspace_tl { none } }
    \clist_map_inline:nn { kx , ky , kz }
      {
        \clist_if_in:NnT \l__mriseq_rows_clist {##1}
          { \bool_set_true:N \l__mriseq_k_needed_bool }
      }
    \bool_if:NT \l__mriseq_k_needed_bool { \__mriseq_k_compute: }
    % ---- layout
    \__mriseq_layout:
    % ---- draw

      % Make the bounding box independent of the clip area
      \__mriseq_exec:e
        {
          \exp_not:N \path [ use~as~bounding~box ]
            ( \fp_eval:n
                {
                  \l__mriseq_xlab_fp
                  - \str_if_eq:VnTF \l__mriseq_kspace_tl { left }
                      { \dim_to_decimal_in_unit:nn { \l__mriseq_kspace_size_dim + \l__mriseq_kspace_gap_dim } { 1cm } + 0.45 }
                      { 0 }
                } cm ,
              \fp_eval:n
                {
                  max( \l__mriseq_header_fp ,
                       \bool_lazy_or:nnTF
                         { \str_if_eq_p:Vn \l__mriseq_kspace_tl { none } }
                         { \str_if_eq_p:Vn \l__mriseq_kspace_tl { below } } { 0 }
                         { \l__mriseq_ybot_fp / 2
                           + \dim_to_decimal_in_unit:nn { \l__mriseq_kspace_size_dim } { 1cm } / 2
                           + \tl_if_blank:VTF \l__mriseq_kspace_title_tl { 0.05 } { 0.4 } } )
                } cm ) rectangle
            ( \fp_eval:n
                {
                  \l__mriseq_width_fp
                  + \str_if_eq:VnTF \l__mriseq_kspace_tl { right }
                      { \dim_to_decimal_in_unit:nn { \l__mriseq_kspace_size_dim + \l__mriseq_kspace_gap_dim } { 1cm } }
                      { 0 }
                } cm ,
              \fp_eval:n
                {
                  min(
                    \l__mriseq_yaxis_fp
                    - \bool_if:NTF \l__mriseq_ticks_bool { 0.45 } { \bool_if:NTF \l__mriseq_axis_bool { 0.35 } { 0 } }
                    - \g__mriseq_botlevels_int * \dim_to_decimal_in_unit:nn { \l__mriseq_intervalsep_dim } { 1cm } ,
                    \str_case:VnF \l__mriseq_kspace_tl
                      {
                        { none } { 0 }
                        { below }
                          {
                            \l__mriseq_yaxis_fp
                            - \bool_if:NTF \l__mriseq_ticks_bool { 0.45 } { \bool_if:NTF \l__mriseq_axis_bool { 0.35 } { 0 } }
                            - \g__mriseq_botlevels_int * \dim_to_decimal_in_unit:nn { \l__mriseq_intervalsep_dim } { 1cm }
                            - \dim_to_decimal_in_unit:nn { \l__mriseq_kspace_gap_dim + \l__mriseq_kspace_size_dim } { 1cm }
                            - \tl_if_blank:VTF \l__mriseq_kspace_title_tl { 0 } { 0.35 } - 0.4
                          }
                      }
                      { \l__mriseq_ybot_fp / 2
                        - \dim_to_decimal_in_unit:nn { \l__mriseq_kspace_size_dim } { 1cm } / 2 - 0.4 } )
                } cm ) ;
        }
      \__mriseq_draw_background:
      \begin{scope}
        \__mriseq_exec:e
          {
            \exp_not:N \clip
              ( 0cm , \fp_eval:n { \l__mriseq_header_fp + 0.6 } cm ) rectangle
              ( \fp_eval:n { \l__mriseq_width_fp } cm , \fp_eval:n { \l__mriseq_ybot_fp - 3 } cm ) ;
          }
        \tl_set:Nn \l__mriseq_mode_tl { lines }
        \cs_set_eq:NN \__mriseq_item:nnn \__mriseq_draw_markers:nnn
        \g__mriseq_items_tl
        \seq_gclear:N \g__mriseq_labbox_seq
        \seq_gclear:N \g__mriseq_obst_seq
        \bool_lazy_and:nnT { \l__mriseq_avoid_bool }
          { \bool_lazy_any_p:n { { \l__mriseq_amplabels_bool } { \l__mriseq_arealabels_bool } { \l__mriseq_adclabels_bool } } }
          {
            \int_gzero:N \g__mriseq_idx_int
            \cs_set_eq:NN \__mriseq_item:nnn \__mriseq_obst_item:nnn
            \g__mriseq_items_tl
          }
        \int_gzero:N \g__mriseq_idx_int
        \cs_set_eq:NN \__mriseq_item:nnn \__mriseq_draw_item:nnn
        \g__mriseq_items_tl
        \int_gset:Nn \g__mriseq_idx_int { -1 }
        \__mriseq_draw_breaks:
        \cs_set_eq:NN \__mriseq_item:nnn \__mriseq_draw_annot:nnn
        \g__mriseq_items_tl
      \end{scope}
      % marker labels are not clipped
      \tl_set:Nn \l__mriseq_mode_tl { labels }
      \cs_set_eq:NN \__mriseq_item:nnn \__mriseq_draw_markers:nnn
      \g__mriseq_items_tl
      \__mriseq_draw_axis:
      \__mriseq_draw_kspace:
    \end{tikzpicture}
  }

