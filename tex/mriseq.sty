%  box of the measured label at (\l__mriseq_tmpa_fp, \l__mriseq_tmpb_fp) with anchor #1
\cs_new_protected:Npn \__mriseq_label_box:n #1
  {
    \tl_set:Ne \l__mriseq_type_tl {#1}
    \tl_trim_spaces:N \l__mriseq_type_tl
    \str_case:VnF \l__mriseq_type_tl
      {
        { north }      { \tl_set:Nn \l__mriseq_type_tl { { -0.5 } { -1 } } }
        { south }      { \tl_set:Nn \l__mriseq_type_tl { { -0.5 } { 0 } } }
        { south~west } { \tl_set:Nn \l__mriseq_type_tl { { 0 } { 0 } } }
        { center }     { \tl_set:Nn \l__mriseq_type_tl { { -0.5 } { -0.5 } } }
      }
      { \tl_set:Nn \l__mriseq_type_tl { { -0.5 } { -0.5 } } }
    \tl_set:Ne \l__mriseq_box_tl
      {
        { \fp_eval:n { \l__mriseq_tmpa_fp + \tl_item:Nn \l__mriseq_type_tl { 1 } * \l__mriseq_labw_fp - 0.03 } }
        { \fp_eval:n { \l__mriseq_tmpb_fp + \tl_item:Nn \l__mriseq_type_tl { 2 } * \l__mriseq_labh_fp - 0.015 } }
        { \fp_eval:n { \l__mriseq_tmpa_fp + ( \tl_item:Nn \l__mriseq_type_tl { 1 } + 1 ) * \l__mriseq_labw_fp + 0.03 } }
        { \fp_eval:n { \l__mriseq_tmpb_fp + ( \tl_item:Nn \l__mriseq_type_tl { 2 } + 1 ) * \l__mriseq_labh_fp + 0.015 } }
      }
  }
\prg_new_protected_conditional:Npnn \__mriseq_box_free: { TF }
  {
    % inside the time window horizontally
    \bool_set:Nn \l_tmpb_bool
      {
        \fp_compare_p:nNn { \tl_item:Nn \l__mriseq_box_tl { 1 } } > { -0.01 }
        && \fp_compare_p:nNn { \tl_item:Nn \l__mriseq_box_tl { 3 } } < { \l__mriseq_width_fp + 0.01 }
      }
    \bool_if:NT \l_tmpb_bool
      {
        \seq_map_inline:Nn \g__mriseq_labbox_seq
          {
            \__mriseq_box_overlap:nnnnnnnnT ##1 \l__mriseq_box_tl
              { \bool_set_false:N \l_tmpb_bool \seq_map_break: }
          }
      }
    \bool_if:NT \l_tmpb_bool
      {
        \seq_map_inline:Nn \g__mriseq_obst_seq
          {
            \int_compare:nNnF { \use_i:nnnnn ##1 } = \g__mriseq_idx_int
              {
                \exp_after:wN \__mriseq_box_overlap:nnnnnnnnT \use_none:n ##1 \l__mriseq_box_tl
                  { \bool_set_false:N \l_tmpb_bool \seq_map_break: }
              }
          }
      }
    \bool_if:NTF \l_tmpb_bool { \prg_return_true: } { \prg_return_false: }
  }
\cs_new_protected:Npn \__mriseq_box_overlap:nnnnnnnnT #1#2#3#4#5
  { \exp_args:No \__mriseq_box_overlap_aux:nnnnnnnnT {#5} {#1} {#2} {#3} {#4} }
\cs_new_protected:Npn \__mriseq_box_overlap_aux:nnnnnnnnT #1#2#3#4#5#6
  { \__mriseq_box_overlap_ii:nnnnnnnnn {#2} {#3} {#4} {#5} #1 {#6} }
