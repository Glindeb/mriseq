  { \tl_if_blank:nTF {#2} { \fp_set:Nn #1 {#3} } { \fp_set:Nn #1 {#2} } }
\cs_generate_variant:Nn \__mriseq_fp_set:Nnn { NVn , NVV }

%  Resolve the start time from start / center / end keys.
%  #1 = total duration expression, #2 = offset of the reference "centre".
\cs_new_protected:Npn \__mriseq_resolve_start:nn #1#2
  {
    \tl_if_blank:VTF \l__mriseq_el_start_tl
      {
        \tl_if_blank:VTF \l__mriseq_el_center_tl
          {
            \tl_if_blank:VTF \l__mriseq_el_end_tl
              { \fp_set:Nn \l__mriseq_s_fp { 0 } }
              { \fp_set:Nn \l__mriseq_s_fp { (\l__mriseq_el_end_tl) - (#1) } }
          }
          { \fp_set:Nn \l__mriseq_s_fp { (\l__mriseq_el_center_tl) - (#2) } }
      }
      { \fp_set:Nn \l__mriseq_s_fp { \l__mriseq_el_start_tl } }
    \fp_set:Nn \l__mriseq_e_fp { \l__mriseq_s_fp + (#1) }
  }

