    \__mriseq_exec:e
      {
        \exp_not:N \draw [ mriseq/grad , draw = \l__mriseq_col_tl , fill = \l__mriseq_fill_tl ,
                           \exp_not:V \l__mriseq_el_style_tl ]
          \exp_not:V \l__mriseq_path_tl -- cycle ;
      }
    \__mriseq_grad_labels:nn { } { \c_false_bool }
  }
%  amplitude / area / custom labels; #1 = prefix (e.g. \pm), #2 = true for tables
%  Amplitude labels go beyond the peak (above a positive, below a negative
%  lobe).  Area labels go inside the flat top when they fit there completely,
%  otherwise on the other side of the zero line.
\tl_new:N \l__mriseq_amptext_tl
\cs_new_protected:Npn \__mriseq_grad_labels:nn #1#2
  {
    \fp_compare:nNnTF \l__mriseq_amp_fp < { 0 }
      { \tl_set:Nn \l__mriseq_row_tl { north } }
      { \tl_set:Nn \l__mriseq_row_tl { south } }
    % amplitude (or custom) label
    \tl_clear:N \l__mriseq_amptext_tl
    \tl_if_blank:VTF \l__mriseq_el_label_tl
      {
        \bool_if:NT \l__mriseq_amplabels_bool
          {
            \tl_set:Ne \l__mriseq_amptext_tl
              { #1 \__mriseq_num:n { \l__mriseq_amp_fp } \tl_if_blank:VF \l__mriseq_gradunit_tl
                  { \exp_not:N \, \exp_not:V \l__mriseq_gradunit_tl } }
          }
      }
      { \tl_set_eq:NN \l__mriseq_amptext_tl \l__mriseq_el_label_tl }
    \tl_if_blank:VF \l__mriseq_amptext_tl
      {
        \__mriseq_value_node:nnnn { \l__mriseq_c_fp } { \l__mriseq_amp_fp }
          { \l__mriseq_row_tl } { \exp_not:V \l__mriseq_amptext_tl }
      }
    % area labels
    \bool_if:NT \l__mriseq_arealabels_bool
      {
        \bool_if:nTF {#2}
          {
            \__mriseq_value_node:nnnn { \l__mriseq_c_fp } { - \l__mriseq_amp_fp } { north }
              { #1 \__mriseq_num:n { \l__mriseq_area_fp } }
          }
          {
            \tl_if_blank:VTF \l__mriseq_el_split_tl
              {
                \__mriseq_area_label:nnn { \l__mriseq_s_fp + \l__mriseq_ru_fp }
                  { \l__mriseq_s_fp + \l__mriseq_ru_fp + \l__mriseq_flat_fp }
                  { \__mriseq_num:n { \l__mriseq_area_fp } \tl_if_blank:VF \l__mriseq_areaunit_tl
                      { \exp_not:N \, \exp_not:V \l__mriseq_areaunit_tl } }
              }
              {
                \fp_set:Nn \l__mriseq_tmpb_fp { \__mriseq_trap_area:n { \l__mriseq_el_split_tl } }
                \__mriseq_area_label:nnn { \l__mriseq_s_fp + \l__mriseq_ru_fp } { \l__mriseq_el_split_tl }
                  { \__mriseq_num:n { \l__mriseq_tmpb_fp } }
                \__mriseq_area_label:nnn { \l__mriseq_el_split_tl }
                  { \l__mriseq_s_fp + \l__mriseq_ru_fp + \l__mriseq_flat_fp }
                  { \__mriseq_num:n { \l__mriseq_area_fp - \l__mriseq_tmpb_fp } }
              }
          }
      }
  }
%  #1 from, #2 to (ms, part of the flat top), #3 text
\cs_new_protected:Npn \__mriseq_area_label:nnn #1#2#3
  {
    \__mriseq_measure:n {#3}
    \__mriseq_label_fits:nnTF { (#2) - (#1) } { \l__mriseq_amp_fp }
      {
        \__mriseq_value_node:nnnnn { ( (#1) + (#2) ) / 2 } { \l__mriseq_amp_fp }
          { \fp_compare:nNnTF \l__mriseq_amp_fp < { 0 } { south } { north } }
          { \exp_not:V \l__mriseq_lab_tl } { mriseq/value~inside }
      }
      {
        \__mriseq_value_node:nnnnn { ( (#1) + (#2) ) / 2 } { 0 }
          { \fp_compare:nNnTF \l__mriseq_amp_fp < { 0 } { south } { north } }
          { \exp_not:V \l__mriseq_lab_tl }
          { mriseq/value~outside ,
            yshift = \fp_compare:nNnTF \l__mriseq_amp_fp < { 0 } { 1.2pt } { -1.2pt } }
      }
  }

% ---- phase-encoding table -----------------------------------------------
\cs_new_protected:cpn { __mriseq_draw_ptable: }
  {
    \__mriseq_colors:nNN { mriseq-grad } \l__mriseq_gradmix_tl \l__mriseq_gradfill_tl
    \fp_set:Nn \l__mriseq_tmpc_fp { abs( \l__mriseq_amp_fp ) }
    % outline: hexagon
    \tl_set:Ne \l__mriseq_path_tl
      {
        \__mriseq_pt:nn { \l__mriseq_s_fp } { 0 }
        -- \__mriseq_pt:nn { \l__mriseq_s_fp + \l__mriseq_ru_fp } { \l__mriseq_tmpc_fp }
        -- \__mriseq_pt:nn { \l__mriseq_s_fp + \l__mriseq_ru_fp + \l__mriseq_flat_fp } { \l__mriseq_tmpc_fp }
        -- \__mriseq_pt:nn { \l__mriseq_e_fp } { 0 }
        -- \__mriseq_pt:nn { \l__mriseq_s_fp + \l__mriseq_ru_fp + \l__mriseq_flat_fp } { - \l__mriseq_tmpc_fp }
        -- \__mriseq_pt:nn { \l__mriseq_s_fp + \l__mriseq_ru_fp } { - \l__mriseq_tmpc_fp }
        -- cycle
      }
    \__mriseq_exec:e
      {
        \exp_not:N \path [ fill = \l__mriseq_fill_tl ] \exp_not:V \l__mriseq_path_tl ;
      }
    % inner levels
    % at most one line per 0.7 mm of height, and an odd number of lines
    \int_set:Nn \l__mriseq_n_int
      {
        \int_min:nn { \l__mriseq_el_lines_tl }
          { \fp_eval:n { 2 * floor( abs( \l__mriseq_tmpc_fp * \l__mriseq_cur_sc_tl ) / 0.07 ) + 1 } }
      }
    \int_compare:nNnT \l__mriseq_n_int > { 1 }
      {
        \tl_clear:N \l__mriseq_path_tl
        \int_step_inline:nnn { 1 } { \l__mriseq_n_int - 2 }
          {
            \fp_set:Nn \l__mriseq_tmpa_fp
              { \l__mriseq_tmpc_fp * ( 1 - 2 * ##1 / ( \l__mriseq_n_int - 1 ) ) }
            \bool_if:NTF \l__mriseq_el_fan_bool
              {
                \tl_put_right:Ne \l__mriseq_path_tl
                  {
                    \__mriseq_pt:nn { \l__mriseq_s_fp } { 0 }
                    -- \__mriseq_pt:nn { \l__mriseq_s_fp + \l__mriseq_ru_fp } { \l__mriseq_tmpa_fp }
                    -- \__mriseq_pt:nn { \l__mriseq_s_fp + \l__mriseq_ru_fp + \l__mriseq_flat_fp } { \l__mriseq_tmpa_fp }
                    -- \__mriseq_pt:nn { \l__mriseq_e_fp } { 0 }
                  }
              }
              {
                \tl_put_right:Ne \l__mriseq_path_tl
                  {
                    \__mriseq_pt:nn { \l__mriseq_s_fp + \l__mriseq_ru_fp * abs(\l__mriseq_tmpa_fp) / \l__mriseq_tmpc_fp } { \l__mriseq_tmpa_fp }
                    -- \__mriseq_pt:nn { \l__mriseq_e_fp - \l__mriseq_rd_fp * abs(\l__mriseq_tmpa_fp) / \l__mriseq_tmpc_fp } { \l__mriseq_tmpa_fp }
                  }
              }
          }
        \__mriseq_exec:e
          {
            \exp_not:N \draw [ mriseq/phase~lines , draw = \l__mriseq_col_tl ]
              \exp_not:V \l__mriseq_path_tl ;
          }
      }
    % outer outline
    \__mriseq_exec:e
      {
        \exp_not:N \draw [ mriseq/phase , draw = \l__mriseq_col_tl , \exp_not:V \l__mriseq_el_style_tl ]
          \__mriseq_pt:nn { \l__mriseq_s_fp } { 0 }
          -- \__mriseq_pt:nn { \l__mriseq_s_fp + \l__mriseq_ru_fp } { \l__mriseq_tmpc_fp }
          -- \__mriseq_pt:nn { \l__mriseq_s_fp + \l__mriseq_ru_fp + \l__mriseq_flat_fp } { \l__mriseq_tmpc_fp }
          -- \__mriseq_pt:nn { \l__mriseq_e_fp } { 0 }
          -- \__mriseq_pt:nn { \l__mriseq_s_fp + \l__mriseq_ru_fp + \l__mriseq_flat_fp } { - \l__mriseq_tmpc_fp }
          -- \__mriseq_pt:nn { \l__mriseq_s_fp + \l__mriseq_ru_fp } { - \l__mriseq_tmpc_fp }
          -- cycle ;
      }
    % highlighted step
    \tl_if_blank:VF \l__mriseq_el_highlight_tl
      {
        \fp_set:Nn \l__mriseq_tmpa_fp { \l__mriseq_tmpc_fp * (\l__mriseq_el_highlight_tl) }
        \__mriseq_exec:e
          {
            \exp_not:N \draw [ mriseq/phase~highlight ]
              \__mriseq_pt:nn { \l__mriseq_s_fp } { 0 }
              -- \__mriseq_pt:nn { \l__mriseq_s_fp + \l__mriseq_ru_fp } { \l__mriseq_tmpa_fp }
              -- \__mriseq_pt:nn { \l__mriseq_s_fp + \l__mriseq_ru_fp + \l__mriseq_flat_fp } { \l__mriseq_tmpa_fp }
              -- \__mriseq_pt:nn { \l__mriseq_e_fp } { 0 } ;
          }
      }
    % stepping arrow
    \str_case:VnF \l__mriseq_el_arrow_tl
      {
        { down } { \tl_set:Nn \l__mriseq_tmp_tl { 1 } }
        { up }   { \tl_set:Nn \l__mriseq_tmp_tl { -1 } }
      }
      { \tl_clear:N \l__mriseq_tmp_tl }
    \tl_if_blank:VF \l__mriseq_tmp_tl
      {
        \__mriseq_exec:e
          {
            \exp_not:N \draw [ mriseq/phase~arrow ]
              \__mriseq_pt:nn { \l__mriseq_e_fp + 0.12 * \l__mriseq_d_fp + 0.1 }
                { \l__mriseq_tmp_tl * \l__mriseq_tmpc_fp }
              -- \__mriseq_pt:nn { \l__mriseq_e_fp + 0.12 * \l__mriseq_d_fp + 0.1 }
                { - \l__mriseq_tmp_tl * \l__mriseq_tmpc_fp } ;
          }
      }
    \fp_set:Nn \l__mriseq_amp_fp { \l__mriseq_tmpc_fp }
    \fp_set:Nn \l__mriseq_area_fp { abs( \l__mriseq_area_fp ) }
    \__mriseq_grad_labels:nn { \exp_not:N \ensuremath { \exp_not:N \pm } } { \c_true_bool }
  }

% ---- ADC ----------------------------------------------------------------
\cs_new_protected:cpn { __mriseq_draw_adc: }
  {
    \__mriseq_colors:nNN { mriseq-adc } \l__mriseq_adcmix_tl \l__mriseq_adcfill_tl
    \__mriseq_exec:e
      {
        \exp_not:N \draw [ mriseq/adc , draw = \l__mriseq_col_tl , fill = \l__mriseq_fill_tl ,
                           \exp_not:V \l__mriseq_el_style_tl ]
          \__mriseq_pt:nn { \l__mriseq_s_fp } { -1 } rectangle
          \__mriseq_pt:nn { \l__mriseq_e_fp } { 1 } ;
      }
    % sample ticks
    \bool_lazy_all:nT
      {
        { \l__mriseq_el_ticks_bool }
        { ! \tl_if_blank_p:V \l__mriseq_el_samples_tl }
        { \int_compare_p:nNn { \l__mriseq_el_samples_tl } < { 513 } }
      }
      {
        \tl_clear:N \l__mriseq_path_tl
        \bool_if:NTF \l__mriseq_lin_bool
          {
            % linear time mapping: only one cheap evaluation per tick
            \fp_set:Nn \l__mriseq_tmpb_fp { \__mriseq_xe:n { \l__mriseq_s_fp } }
            \fp_set:Nn \l__mriseq_tmpc_fp
              { \l__mriseq_d_fp * \l__mriseq_k_fp / ( \l__mriseq_el_samples_tl ) }
            \tl_set:Ne \l__mriseq_tmp_tl
              { ++ ( 0 , \fp_eval:n { round( 0.28 * \l__mriseq_cur_sc_tl , 4 ) } cm ) }
            \tl_set:Ne \l__mriseq_type_tl { \__mriseq_y:n { -1 } }
            \int_step_inline:nn { \l__mriseq_el_samples_tl }
              {
                \tl_put_right:Ne \l__mriseq_path_tl
                  {
                    ( \fp_eval:n { round( \l__mriseq_tmpb_fp + ( ##1 - 0.5 ) * \l__mriseq_tmpc_fp , 4 ) } cm ,
                      \l__mriseq_type_tl cm ) -- \exp_not:V \l__mriseq_tmp_tl
                  }
              }
          }
          {
            \int_step_inline:nn { \l__mriseq_el_samples_tl }
              {
                \fp_set:Nn \l__mriseq_tmpa_fp
                  { \l__mriseq_s_fp + ( ##1 - 0.5 ) * \l__mriseq_d_fp / ( \l__mriseq_el_samples_tl ) }
                \tl_put_right:Ne \l__mriseq_path_tl
                  {
                    \__mriseq_pt:nn { \l__mriseq_tmpa_fp } { -1 }
                    -- \__mriseq_pt:nn { \l__mriseq_tmpa_fp } { -0.72 }
                  }
              }
          }
        \__mriseq_exec:e
          {
            \exp_not:N \draw [ mriseq/adc~ticks , draw = \l__mriseq_col_tl ]
              \exp_not:V \l__mriseq_path_tl ;
          }
      }
    % k = 0 marker
    \tl_if_blank:VF \l__mriseq_el_kzero_tl
      {
        \__mriseq_exec:e
          {
            \exp_not:N \draw [ mriseq/kzero , draw = \l__mriseq_col_tl ]
              \__mriseq_pt:nn { \l__mriseq_el_kzero_tl } { 0 } circle [ radius = 1.6pt ] ;
          }
      }
    % label
    \tl_if_blank:VTF \l__mriseq_el_label_tl
      {
        \bool_lazy_all:nT
          {
            { \l__mriseq_adclabels_bool }
            { ! \tl_if_blank_p:V \l__mriseq_el_samples_tl }
            { ! \tl_if_blank_p:V \l__mriseq_el_dwell_tl }
          }
          {
            \tl_set:Ne \l__mriseq_el_label_tl
              {
                \__mriseq_num:n { \l__mriseq_el_samples_tl }
                \exp_not:N \, \exp_not:N \ensuremath { \exp_not:N \times } \exp_not:N \,
                \__mriseq_num:n { (\l__mriseq_el_dwell_tl) * 1000 }
                \exp_not:N \, \exp_not:N \ensuremath { \exp_not:N \mu } s
              }
          }
      }
      { }
    \tl_if_blank:VF \l__mriseq_el_label_tl
      {
        \__mriseq_value_node:nnnn { \l__mriseq_s_fp } { 1 } { south~west }
          { \exp_not:V \l__mriseq_el_label_tl }
      }
  }

% ---- signals ------------------------------------------------------------
\tl_new:N \l__mriseq_sep_tl
\cs_new_protected:Npn \__mriseq_signal_path:nn #1#2
  % #1 = start, #2 = expression in t (absolute time) using \l__mriseq_tmpa_fp
  {
    \tl_if_blank:VT \l__mriseq_el_res_tl
      { \tl_set:Nn \l__mriseq_el_res_tl { 150 } }
    \int_set:Nn \l__mriseq_n_int { \l__mriseq_el_res_tl }
    \tl_clear:N \l__mriseq_path_tl
    \int_step_inline:nnn { 0 } { \l__mriseq_n_int }
      {
        \fp_set:Nn \l__mriseq_tmpa_fp { #1 + ##1 * \l__mriseq_d_fp / \l__mriseq_n_int }
        \tl_put_right:Ne \l__mriseq_path_tl
          {
            \int_compare:nNnF {##1} = { 0 } { \l__mriseq_sep_tl }
            \__mriseq_pt:nn { \l__mriseq_tmpa_fp } { #2 }
          }
      }
  }
\cs_new_protected:Npn \__mriseq_signal_draw:nnn #1#2#3
  % #1 start, #2 envelope expression (t = \l__mriseq_tmpa_fp),
  % #3 the envelope in pgfmath syntax (reserved for a faster path; unused)
  %
  {
    \__mriseq_colors:nNN { mriseq-signal } \l__mriseq_sigmix_tl \c_empty_tl
    \fp_set_eq:NN \l__mriseq_tmpc_fp \l__mriseq_ttwo_fp
    \tl_if_blank:VT \l__mriseq_el_res_tl
      {
        \tl_set:Ne \l__mriseq_el_res_tl
          {
            \fp_eval:n
              { min( 160 , ceil( 5 * abs(\l__mriseq_el_cycles_tl) * \l__mriseq_d_fp / \l__mriseq_ttwo_fp ) + 8 ) }
          }
      }
    {
    \bool_if:NTF \l__mriseq_el_osc_bool
      {
        \tl_clear:N \l__mriseq_sep_tl
        \__mriseq_signal_path:nn {#1}
          {
            \l__mriseq_amp_fp * (#2) * cos( 2 * pi * (\l__mriseq_el_cycles_tl) / \l__mriseq_tmpc_fp
                                         * ( \l__mriseq_tmpa_fp - \l__mriseq_c_fp ) )
          }
        \__mriseq_exec:e
          {
            \exp_not:N \draw [ mriseq/signal , draw = \l__mriseq_col_tl , \exp_not:V \l__mriseq_el_style_tl ]
              plot [ smooth , tension = 0.55 ] coordinates { \exp_not:V \l__mriseq_path_tl } ;
          }
      }
      {
        \tl_set:Nn \l__mriseq_sep_tl { -- }
        \__mriseq_signal_path:nn {#1} { \l__mriseq_amp_fp * (#2) }
        \tl_set_eq:NN \l__mriseq_tmp_tl \l__mriseq_path_tl
        \fp_set:Nn \l__mriseq_amp_fp { - \l__mriseq_amp_fp }
        \__mriseq_signal_path:nn {#1} { \l__mriseq_amp_fp * (#2) }
        \__mriseq_exec:e
          {
            \exp_not:N \draw [ mriseq/signal , draw = \l__mriseq_col_tl , fill = \l__mriseq_fill_tl ,
                               \exp_not:V \l__mriseq_el_style_tl ]
              \exp_not:V \l__mriseq_tmp_tl ;
            \exp_not:N \draw [ mriseq/signal , draw = \l__mriseq_col_tl , fill = \l__mriseq_fill_tl ,
                               \exp_not:V \l__mriseq_el_style_tl ]
              \exp_not:V \l__mriseq_path_tl ;
          }
      }
    }
  }
\cs_new_protected:cpn { __mriseq_draw_fid: }
  {
    \__mriseq_signal_draw:nnn { \l__mriseq_s_fp }
      { exp( - ( \l__mriseq_tmpa_fp - \l__mriseq_s_fp ) / \l__mriseq_tmpc_fp ) }
      { exp( - ( \exp_not:N \t - \fp_eval:n { \l__mriseq_s_fp } ) / \fp_eval:n { \l__mriseq_ttwo_fp } ) }
  }
\cs_new_protected:cpn { __mriseq_draw_echo: }
  {
    \__mriseq_signal_draw:nnn { \l__mriseq_s_fp }
      { exp( - abs( \l__mriseq_tmpa_fp - \l__mriseq_c_fp ) / \l__mriseq_tmpc_fp ) }
      { exp( - abs( \exp_not:N \t - \fp_eval:n { \l__mriseq_c_fp } ) / \fp_eval:n { \l__mriseq_ttwo_fp } ) }
  }

% ---- free waveform ------------------------------------------------------
\cs_new_protected:cpn { __mriseq_draw_wave: }
  {
    \str_case:VnF \l__mriseq_group_tl
      {
        { rf }  { \__mriseq_colors:nNN { mriseq-rf-excite } \l__mriseq_rfmix_tl \l__mriseq_rffill_tl }
        { adc } { \__mriseq_colors:nNN { mriseq-adc } \l__mriseq_adcmix_tl \l__mriseq_adcfill_tl }
        { sig } { \__mriseq_colors:nNN { mriseq-signal } \l__mriseq_sigmix_tl \c_empty_tl }
        { mz }  { \__mriseq_colors:nNN { mriseq-signal } \l__mriseq_sigmix_tl \c_empty_tl }
        { kx }  { \__mriseq_colors:nNN { mriseq-k } \l__mriseq_sigmix_tl \c_empty_tl }
        { ky }  { \__mriseq_colors:nNN { mriseq-k } \l__mriseq_sigmix_tl \c_empty_tl }
        { kz }  { \__mriseq_colors:nNN { mriseq-k } \l__mriseq_sigmix_tl \c_empty_tl }
      }
      { \__mriseq_colors:nNN { mriseq-grad } \l__mriseq_gradmix_tl \l__mriseq_gradfill_tl }
    \tl_clear:N \l__mriseq_path_tl
    \bool_set_true:N \l_tmpa_bool
    \exp_args:NV \clist_map_inline:nn \l__mriseq_el_points_tl
      {
        \bool_if:NTF \l_tmpa_bool
          { \bool_set_false:N \l_tmpa_bool }
          { \tl_put_right:Nn \l__mriseq_path_tl { -- } }
        \__mriseq_wave_point:w ##1 \q_stop
      }
    \bool_if:NTF \l__mriseq_el_filled_bool
      {
        \__mriseq_exec:e
          {
            \exp_not:N \path [ fill = \l__mriseq_fill_tl ]
              \__mriseq_pt:nn { \l__mriseq_s_fp } { 0 } --
              \exp_not:V \l__mriseq_path_tl -- \__mriseq_pt:nn { \l__mriseq_e_fp } { 0 } -- cycle ;
          }
      }
      { }
    \__mriseq_exec:e
      {
        \exp_not:N \draw [ mriseq/wave , draw = \l__mriseq_col_tl , \exp_not:V \l__mriseq_el_style_tl ]
          \exp_not:V \l__mriseq_path_tl ;
      }
    \tl_if_blank:VF \l__mriseq_el_label_tl
      {
        \__mriseq_value_node:nnnn { ( \l__mriseq_s_fp + \l__mriseq_e_fp ) / 2 } { \l__mriseq_max_fp }
          { south } { \exp_not:V \l__mriseq_el_label_tl }
      }
  }
\cs_new_protected:Npn \__mriseq_wave_point:w #1 / #2 \q_stop
  { \tl_put_right:Ne \l__mriseq_path_tl { \__mriseq_pt:nn {#1} {#2} } }

% ---- shaded areas -------------------------------------------------------
%  \shadearea fills the part of the waveforms of one row between two times.
\tl_new:N \l__mriseq_shade_row_tl
\tl_new:N \l__mriseq_shade_style_tl
\fp_new:N \l__mriseq_shade_from_fp
\fp_new:N \l__mriseq_shade_to_fp
\fp_new:N \g__mriseq_shade_area_fp
\fp_new:N \g__mriseq_shade_amp_fp
\cs_new_protected:Npn \__mriseq_draw_shade:n #1
  {
    \seq_if_in:NnT \l__mriseq_vrows_seq {#1}
      {
        \tl_set:Nn \l__mriseq_shade_row_tl {#1}
        \tl_if_blank:VT \l__mriseq_el_style_tl { \tl_set:Nn \l__mriseq_el_style_tl { A } }
        \str_case_e:nnF { \tl_to_str:V \l__mriseq_el_style_tl }
          {
            { A } { \tl_set:Nn \l__mriseq_shade_style_tl { mriseq/area~A } }
            { B } { \tl_set:Nn \l__mriseq_shade_style_tl { mriseq/area~B } }
            { C } { \tl_set:Nn \l__mriseq_shade_style_tl { mriseq/area~C } }
            { D } { \tl_set:Nn \l__mriseq_shade_style_tl { mriseq/area~D } }
          }
          { \tl_set_eq:NN \l__mriseq_shade_style_tl \l__mriseq_el_style_tl }
        \fp_set:Nn \l__mriseq_shade_from_fp { \l__mriseq_el_from_tl }
        \fp_set:Nn \l__mriseq_shade_to_fp { \l__mriseq_el_to_tl }
        \tl_set_eq:NN \l__mriseq_lab_tl \l__mriseq_el_label_tl
        \__mriseq_use_row:n {#1}
        \fp_gzero:N \g__mriseq_shade_area_fp
        \fp_gzero:N \g__mriseq_shade_amp_fp
        \__mriseq_exec:e
          {
            \exp_not:N \begin{scope}
            \exp_not:N \clip
              ( \__mriseq_x:n { \l__mriseq_shade_from_fp } cm , \tl_use:c { l__mriseq_row_#1_ytop_tl } cm )
              rectangle
              ( \__mriseq_x:n { \l__mriseq_shade_to_fp } cm , \l__mriseq_cur_ybot_tl cm ) ;
          }
        \group_begin:
          \cs_set_eq:NN \__mriseq_item:nnn \__mriseq_shade_item:nnn
          \g__mriseq_items_tl
        \group_end:
        \end{scope}
        % label: "auto" prints the area of the shaded part
        \tl_if_blank:VF \l__mriseq_lab_tl
          {
            \str_if_eq:VnT \l__mriseq_lab_tl { auto }
              {
                \tl_set:Ne \l__mriseq_lab_tl
                  { \__mriseq_num:n { \g__mriseq_shade_area_fp } \tl_if_blank:VF \l__mriseq_areaunit_tl
                      { \exp_not:N \, \exp_not:V \l__mriseq_areaunit_tl } }
              }
            \__mriseq_use_row:n {#1}
            \fp_set_eq:NN \l__mriseq_amp_fp \g__mriseq_shade_amp_fp
            \__mriseq_measure:n { \exp_not:V \l__mriseq_lab_tl }
            \__mriseq_label_fits:nnTF
              { \l__mriseq_shade_to_fp - \l__mriseq_shade_from_fp } { \l__mriseq_amp_fp }
              {
                \__mriseq_value_node:nnnnn
                  { ( \l__mriseq_shade_from_fp + \l__mriseq_shade_to_fp ) / 2 } { \l__mriseq_amp_fp / 2 }
                  { center } { \exp_not:V \l__mriseq_lab_tl } { mriseq/value~inside , mriseq/area~label }
              }
              {
                \__mriseq_value_node:nnnnn
                  { ( \l__mriseq_shade_from_fp + \l__mriseq_shade_to_fp ) / 2 } { 0 }
                  { \fp_compare:nNnTF \l__mriseq_amp_fp < { 0 } { south } { north } }
                  { \exp_not:V \l__mriseq_lab_tl }
                  { mriseq/value~outside , mriseq/area~label ,
                    yshift = \fp_compare:nNnTF \l__mriseq_amp_fp < { 0 } { 1.2pt } { -1.2pt } }
              }
          }
      }
  }
\cs_new_protected:Npn \__mriseq_shade_item:nnn #1#2#3
  {
    \str_if_eq:VnT \l__mriseq_shade_row_tl {#2}
      {
        \str_case:nn {#1}
          {
            { grad }   { \__mriseq_shade_trap:nnn {#1} {#2} {#3} }
            { ptable } { \__mriseq_shade_trap:nnn {#1} {#2} {#3} }
          }
      }
  }
\cs_new_protected:Npn \__mriseq_shade_trap:nnn #1#2#3
  {
    \group_begin:
      \keys_set:nn { mriseq / el } {#3}
      \__mriseq_compute:n {#1}
      \bool_lazy_and:nnT
        { \fp_compare_p:nNn \l__mriseq_e_fp > \l__mriseq_shade_from_fp }
        { \fp_compare_p:nNn \l__mriseq_s_fp < \l__mriseq_shade_to_fp }
        {
          \str_if_eq:nnT {#1} { ptable }
            {
              \fp_set:Nn \l__mriseq_amp_fp
                { abs( \l__mriseq_amp_fp ) * \tl_if_blank:VTF \l__mriseq_el_highlight_tl { 1 } { ( \l__mriseq_el_highlight_tl ) } }
            }
          \__mriseq_colors:nNN { mriseq-grad } \l__mriseq_gradmix_tl \l__mriseq_gradfill_tl
          \__mriseq_trap_path:n { \l__mriseq_amp_fp }
          \__mriseq_exec:e
            {
              \exp_not:N \fill [ \exp_not:V \l__mriseq_shade_style_tl ]
                \exp_not:V \l__mriseq_path_tl -- cycle ;
              \exp_not:N \draw [ mriseq/grad , draw = \l__mriseq_col_tl ]
                \exp_not:V \l__mriseq_path_tl -- cycle ;
            }
          \fp_gadd:Nn \g__mriseq_shade_area_fp
            {
              \__mriseq_trap_area:n { min( max( \l__mriseq_shade_to_fp , \l__mriseq_s_fp ) , \l__mriseq_e_fp ) }
              - \__mriseq_trap_area:n { min( max( \l__mriseq_shade_from_fp , \l__mriseq_s_fp ) , \l__mriseq_e_fp ) }
            }
          \fp_compare:nNnT { abs( \l__mriseq_amp_fp ) } > { abs( \g__mriseq_shade_amp_fp ) }
            { \fp_gset_eq:NN \g__mriseq_shade_amp_fp \l__mriseq_amp_fp }
        }
    \group_end:
  }

% ---- markers ------------------------------------------------------------
\cs_new_protected:Npn \__mriseq_draw_marker:
  {
    \bool_if:NT \l__mriseq_markers_bool
      {
        \tl_if_blank:VT \l__mriseq_el_kind_tl { \tl_set:Nn \l__mriseq_el_kind_tl { plain } }
        \str_case:VnF \l__mriseq_el_kind_tl
          {
            { echo } { \tl_set:Nn \l__mriseq_tmp_tl { mriseq/echo~marker } }
          }
          { \tl_set:Nn \l__mriseq_tmp_tl { mriseq/marker } }
        \tl_if_blank:VTF \l__mriseq_el_color_tl
          {
            \str_case:VnF \l__mriseq_el_kind_tl
              {
                { echo }    { \tl_set:Nn \l__mriseq_col_tl { mriseq-echo } }
                { excite }  { \tl_set:Nn \l__mriseq_col_tl { mriseq-rf-excite } }
                { refocus } { \tl_set:Nn \l__mriseq_col_tl { mriseq-rf-refocus } }
                { invert }  { \tl_set:Nn \l__mriseq_col_tl { mriseq-rf-invert } }
              }
              { \tl_set:Nn \l__mriseq_col_tl { mriseq-marker } }
          }
          { \tl_set_eq:NN \l__mriseq_col_tl \l__mriseq_el_color_tl }
        \fp_set:Nn \l__mriseq_tmpa_fp { \__mriseq_xe:n { \l__mriseq_el_center_tl } }
        \str_if_eq:VnT \l__mriseq_mode_tl { lines }
          {
            \__mriseq_exec:e
              {
                \exp_not:N \draw [ \l__mriseq_tmp_tl , draw = \l__mriseq_col_tl , \exp_not:V \l__mriseq_el_style_tl ]
                  ( \fp_eval:n { \l__mriseq_tmpa_fp } cm , 0cm ) --
                  ( \fp_eval:n { \l__mriseq_tmpa_fp } cm , \fp_eval:n { \l__mriseq_ybot_fp } cm ) ;
              }
          }
        \bool_lazy_all:nT
          {
            { \str_if_eq_p:Vn \l__mriseq_mode_tl { labels } }
            { ! \tl_if_blank_p:V \l__mriseq_el_label_tl }
            { \fp_compare_p:nNn \l__mriseq_tmpa_fp > { -0.001 } }
            { \fp_compare_p:nNn \l__mriseq_tmpa_fp < { \l__mriseq_width_fp + 0.001 } }
          }
          {
            \str_if_eq:VnTF \l__mriseq_el_kind_tl { echo }
              {
                \__mriseq_exec:e
                  {
                    \exp_not:N \fill [ \l__mriseq_col_tl ]
                      ( \fp_eval:n { \l__mriseq_tmpa_fp } cm , 0.04cm ) --
                      ( \fp_eval:n { \l__mriseq_tmpa_fp - 0.07 } cm , 0.17cm ) --
                      ( \fp_eval:n { \l__mriseq_tmpa_fp + 0.07 } cm , 0.17cm ) -- cycle ;
                    \exp_not:N \node [ mriseq/marker~label , anchor = west ]
                      at ( \fp_eval:n { \l__mriseq_tmpa_fp + 0.07 } cm , 0.12cm )
                      { \exp_not:V \l__mriseq_el_label_tl } ;
                  }
              }
              {
                \__mriseq_exec:e
                  {
                    \exp_not:N \node [ mriseq/marker~label , anchor = south ]
                      at ( \fp_eval:n { \l__mriseq_tmpa_fp } cm , 0.02cm )
                      { \exp_not:V \l__mriseq_el_label_tl } ;
                  }
              }
          }
      }
  }

% ---- intervals ----------------------------------------------------------
\cs_new_protected:Npn \__mriseq_draw_interval:
  {
    \fp_set:Nn \l__mriseq_tmpa_fp { \__mriseq_xe:n { \l__mriseq_el_from_tl } }
    \fp_set:Nn \l__mriseq_tmpb_fp { \__mriseq_xe:n { \l__mriseq_el_to_tl } }
    \bool_set_false:N \l_tmpa_bool
    \str_case:VnF \l__mriseq_el_pos_tl
      {
        { top }
          {
            \bool_set_true:N \l_tmpa_bool
            \fp_set:Nn \l__mriseq_tmpc_fp
              {
                \bool_if:NTF \g__mriseq_markerlabel_bool
                  { \dim_to_decimal_in_unit:nn { \l__mriseq_markerspace_dim } { 1cm } } { 0.08 }
                + ( \l__mriseq_el_level_tl - 1 )
                  * \dim_to_decimal_in_unit:nn { \l__mriseq_intervalsep_dim } { 1cm } + 0.1
              }
          }
        { bottom }
          {
            \fp_set:Nn \l__mriseq_tmpc_fp
              {
                \l__mriseq_yaxis_fp
                - \bool_lazy_or:nnTF { \l__mriseq_ticks_bool } { \l__mriseq_axis_bool } { 0.45 } { 0.05 }
                - ( \l__mriseq_el_level_tl - 0.5 )
                  * \dim_to_decimal_in_unit:nn { \l__mriseq_intervalsep_dim } { 1cm }
              }
          }
      }
      {
        \seq_if_in:NVTF \l__mriseq_vrows_seq \l__mriseq_el_pos_tl
          {
            \__mriseq_use_row:V \l__mriseq_el_pos_tl
            \fp_set:Nn \l__mriseq_tmpc_fp
              { \l__mriseq_cur_ybot_tl + (\l__mriseq_el_height_tl) * \l__mriseq_cur_h_tl }
          }
          { \fp_set:Nn \l__mriseq_tmpc_fp { nan } }
      }
    % clip the interval to the time window; no arrow tip at a clipped end
    \tl_set:Ne \l__mriseq_tmp_tl
      {
        \fp_compare:nNnTF \l__mriseq_tmpa_fp < { -0.001 } { } { Stealth[length=3.5pt] } -
        \fp_compare:nNnTF \l__mriseq_tmpb_fp > { \l__mriseq_width_fp + 0.001 } { } { Stealth[length=3.5pt] }
      }
    \fp_set:Nn \l__mriseq_tmpa_fp { max( \l__mriseq_tmpa_fp , 0 ) }
    \fp_set:Nn \l__mriseq_tmpb_fp { min( \l__mriseq_tmpb_fp , \l__mriseq_width_fp ) }
    \fp_compare:nNnF { \l__mriseq_tmpb_fp - \l__mriseq_tmpa_fp } > { 0.05 }
      { \fp_set:Nn \l__mriseq_tmpc_fp { nan } }
    \fp_if_nan:nF { \l__mriseq_tmpc_fp }
      {
        \__mriseq_exec:e
          {
            \bool_lazy_all:nT
              { { \l_tmpa_bool } { \l__mriseq_el_guides_bool } { \str_if_eq_p:Vn \l__mriseq_mode_tl { lines } } }
              {
                \exp_not:N \draw [ mriseq/guide ]
                  ( \fp_eval:n { \l__mriseq_tmpa_fp } cm , \fp_eval:n { \l__mriseq_tmpc_fp } cm )
                  -- ( \fp_eval:n { \l__mriseq_tmpa_fp } cm , 0cm )
                  ( \fp_eval:n { \l__mriseq_tmpb_fp } cm , \fp_eval:n { \l__mriseq_tmpc_fp } cm )
                  -- ( \fp_eval:n { \l__mriseq_tmpb_fp } cm , 0cm ) ;
              }
            \str_if_eq:VnT \l__mriseq_mode_tl { annot }
              {
                \exp_not:N \draw [ mriseq/interval , arrows = { \l__mriseq_tmp_tl } ,
                                   \exp_not:V \l__mriseq_el_style_tl ]
                  ( \fp_eval:n { \l__mriseq_tmpa_fp } cm , \fp_eval:n { \l__mriseq_tmpc_fp } cm )
                  -- node [ mriseq/interval~label , anchor = south , fill = mriseq-bg ]
                     { \exp_not:V \l__mriseq_el_label_tl }
                  ( \fp_eval:n { \l__mriseq_tmpb_fp } cm , \fp_eval:n { \l__mriseq_tmpc_fp } cm ) ;
              }
          }
      }
  }
\cs_generate_variant:Nn \__mriseq_use_row:n { V }
\cs_generate_variant:Nn \seq_if_in:NnTF { NV }

% ---- background, axis and breaks ---------------------------------------
\cs_new_protected:Npn \__mriseq_tick_step:
  {
    \tl_if_blank:VTF \l__mriseq_tickstep_tl
      {
        \fp_set:Nn \l__mriseq_tmpa_fp { \l__mriseq_width_fp / \l__mriseq_k_fp / 9 }
        \fp_set:Nn \l__mriseq_tmpb_fp { 10 ^ floor( ln( \l__mriseq_tmpa_fp ) / ln(10) ) }
        \fp_set:Nn \l__mriseq_tmpa_fp { \l__mriseq_tmpa_fp / \l__mriseq_tmpb_fp }
        \fp_set:Nn \l__mriseq_step_fp
          {
            \l__mriseq_tmpb_fp *
            ( \l__mriseq_tmpa_fp < 1.5 ? 1 : ( \l__mriseq_tmpa_fp < 3.5 ? 2 : ( \l__mriseq_tmpa_fp < 7.5 ? 5 : 10 ) ) )
          }
      }
      { \fp_set:Nn \l__mriseq_step_fp { \l__mriseq_tickstep_tl } }
  }
%  is time #1 inside a break?  (with a small margin)
\cs_new_protected:Npn \__mriseq_if_in_break:nTF #1#2#3
  {
    \bool_set_false:N \l_tmpb_bool
    \seq_map_inline:Nn \l__mriseq_breaks_seq
      {
        \fp_compare:nT
          {
            \use_i:nn ##1 - 0.2 * \l__mriseq_step_fp < #1 < \use_ii:nn ##1 + 0.2 * \l__mriseq_step_fp
          }
          { \bool_set_true:N \l_tmpb_bool }
      }
    \bool_if:NTF \l_tmpb_bool {#2} {#3}
  }

\prg_generate_conditional_variant:Nnn \tl_if_blank:n { v } { T , F , TF }
\cs_new_protected:Npn \__mriseq_draw_background:
  {
    % grid
    \bool_if:NT \l__mriseq_grid_bool
      {
        \__mriseq_tick_step:
        \tl_clear:N \l__mriseq_path_tl
        \int_step_inline:nnn
          { \fp_eval:n { ceil( \l__mriseq_tmin_fp / \l__mriseq_step_fp ) } }
          { \fp_eval:n { floor( \l__mriseq_tmax_fp / \l__mriseq_step_fp ) } }
          {
            \__mriseq_if_in_break:nTF { ##1 * \l__mriseq_step_fp } { }
              {
                \tl_put_right:Ne \l__mriseq_path_tl
                  {
                    ( \__mriseq_x:n { ##1 * \l__mriseq_step_fp } cm , 0cm ) --
                    ( \__mriseq_x:n { ##1 * \l__mriseq_step_fp } cm , \fp_eval:n { \l__mriseq_ybot_fp } cm )
                  }
              }
          }
        \__mriseq_exec:e { \exp_not:N \draw [ mriseq/grid ] \exp_not:V \l__mriseq_path_tl ; }
      }
    % rows: separators, baselines, labels
    \seq_map_inline:Nn \l__mriseq_vrows_seq
      {
        \__mriseq_use_row:n {##1}
        \bool_if:NT \l__mriseq_rowlines_bool
          {
            \__mriseq_exec:e
              {
                \exp_not:N \draw [ mriseq/row~line ]
                  ( \fp_eval:n { \l__mriseq_xlab_fp } cm , \l__mriseq_cur_ybot_tl cm ) --
                  ( \fp_eval:n { \l__mriseq_width_fp } cm , \l__mriseq_cur_ybot_tl cm ) ;
              }
          }
        \bool_if:NT \l__mriseq_baselines_bool
          {
            \__mriseq_exec:e
              {
                \exp_not:N \draw [ mriseq/baseline ]
                  ( 0cm , \l__mriseq_cur_yb_tl cm ) --
                  ( \fp_eval:n { \l__mriseq_width_fp } cm , \l__mriseq_cur_yb_tl cm ) ;
              }
          }
        \bool_if:NT \l__mriseq_rowlabels_bool
          {
            \__mriseq_exec:e
              {
                \exp_not:N \node [ mriseq/row~label , anchor = west ]
                  at ( \fp_eval:n { \l__mriseq_xlab_fp } cm ,
                       \fp_eval:n { ( \tl_use:c { l__mriseq_row_##1_ytop_tl } + \l__mriseq_cur_ybot_tl ) / 2 } cm )
                  {
                    \exp_not:v { l__mriseq_row_##1_label_tl }
                    \tl_if_blank:vF { l__mriseq_row_##1_sub_tl }
                      {
                        \exp_not:N \\ [ -1pt ]
                        { \exp_not:N \mriseq@sublabelfont \exp_not:v { l__mriseq_row_##1_sub_tl } }
                      }
                  } ;
              }
          }
      }
    \bool_if:NT \l__mriseq_rowlines_bool
      {
        \seq_if_empty:NF \l__mriseq_vrows_seq
          {
            \__mriseq_exec:e
              {
                \exp_not:N \draw [ mriseq/row~line ]
                  ( \fp_eval:n { \l__mriseq_xlab_fp } cm , 0cm ) --
                  ( \fp_eval:n { \l__mriseq_width_fp } cm , 0cm ) ;
              }
          }
      }
  }

\cs_new_protected:Npn \__mriseq_draw_axis:
  {
    \bool_if:NTF \l__mriseq_ticks_bool
      {
        \__mriseq_tick_step:
        % axis line, interrupted at the breaks
        \tl_clear:N \l__mriseq_path_tl
        \fp_set_eq:NN \l__mriseq_tmpb_fp \l__mriseq_tmin_fp
        \seq_map_inline:Nn \l__mriseq_breaks_seq
          {
            \tl_put_right:Ne \l__mriseq_path_tl
              {
                ( \__mriseq_x:n { \l__mriseq_tmpb_fp } cm , \fp_eval:n { \l__mriseq_yaxis_fp } cm ) --
                ( \fp_eval:n { \__mriseq_xe:n { (\use_i:nn ##1 + \use_ii:nn ##1) / 2 } - 0.06 } cm ,
                  \fp_eval:n { \l__mriseq_yaxis_fp } cm )
              }
            \fp_set:Nn \l__mriseq_tmpb_fp { \use_ii:nn ##1 }
            \tl_put_right:Ne \l__mriseq_path_tl
              {
                ( \fp_eval:n { \__mriseq_xe:n { (\use_i:nn ##1 + \use_ii:nn ##1) / 2 } + 0.06 } cm ,
                  \fp_eval:n { \l__mriseq_yaxis_fp } cm )
              }
          }
        \tl_put_right:Ne \l__mriseq_path_tl
          {
            \seq_if_empty:NF \l__mriseq_breaks_seq { -- }
            \seq_if_empty:NT \l__mriseq_breaks_seq
              { ( 0cm , \fp_eval:n { \l__mriseq_yaxis_fp } cm ) -- }
            ( \fp_eval:n { \l__mriseq_width_fp } cm , \fp_eval:n { \l__mriseq_yaxis_fp } cm )
          }
        \__mriseq_exec:e { \exp_not:N \draw [ mriseq/axis ] \exp_not:V \l__mriseq_path_tl ; }
        % ticks
        \int_step_inline:nnn
          { \fp_eval:n { ceil( \l__mriseq_tmin_fp / \l__mriseq_step_fp ) } }
          { \fp_eval:n { floor( \l__mriseq_tmax_fp / \l__mriseq_step_fp ) } }
          {
            \__mriseq_if_in_break:nTF { ##1 * \l__mriseq_step_fp } { }
              {
                \__mriseq_exec:e
                  {
                    \exp_not:N \draw [ mriseq/axis ]
                      ( \__mriseq_x:n { ##1 * \l__mriseq_step_fp } cm , \fp_eval:n { \l__mriseq_yaxis_fp } cm )
                      -- ++ ( 0 , -0.08cm )
                      node [ mriseq/tick~label , anchor = north ]
                      { \fp_eval:n { round( ##1 * \l__mriseq_step_fp , 3 ) } } ;
                  }
              }
          }
        \bool_if:NT \l__mriseq_rowlabels_bool
          {
            \__mriseq_exec:e
              {
                \exp_not:N \node [ mriseq/tick~label , anchor = north~west ]
                  at ( \fp_eval:n { \l__mriseq_xlab_fp } cm , \fp_eval:n { \l__mriseq_yaxis_fp - 0.08 } cm )
                  { \exp_not:V \l__mriseq_axislabel_tl } ;
              }
          }
      }
      {
        \bool_if:NT \l__mriseq_axis_bool
          {
            \__mriseq_exec:e
              {
                \exp_not:N \draw [ mriseq/axis~arrow ]
                  ( 0cm , \fp_eval:n { \l__mriseq_yaxis_fp } cm ) --
                  ( \fp_eval:n { \l__mriseq_width_fp } cm , \fp_eval:n { \l__mriseq_yaxis_fp } cm )
                  node [ mriseq/tick~label , anchor = north~east ] { \exp_not:V \l__mriseq_timelabel_tl } ;
              }
          }
      }
  }

\cs_new_protected:Npn \__mriseq_draw_breaks:
  {
    \seq_map_inline:Nn \l__mriseq_breaks_seq
      {
        \fp_set:Nn \l__mriseq_tmpa_fp { \__mriseq_xe:n { (\use_i:nn ##1 + \use_ii:nn ##1) / 2 } }
        \seq_map_inline:Nn \l__mriseq_vrows_seq
          {
            \__mriseq_use_row:n {####1}
            \__mriseq_break_symbol:nn { \l__mriseq_tmpa_fp } { \l__mriseq_cur_yb_tl }
          }
        \bool_if:NT \l__mriseq_ticks_bool
          { \__mriseq_break_symbol:nn { \l__mriseq_tmpa_fp } { \l__mriseq_yaxis_fp } }
      }
  }
\cs_new_protected:Npn \__mriseq_break_symbol:nn #1#2
  { \use:c { __mriseq_break_ \l__mriseq_breakstyle_tl :nn } {#1} {#2} }
\cs_new_protected:Npn \__mriseq_break_none:nn #1#2 { }
\cs_new_protected:Npn \__mriseq_break_zigzag:nn #1#2
  {
    \__mriseq_exec:e
      {
        \exp_not:N \fill [ mriseq-bg ]
          ( \fp_eval:n { #1 - 0.13 } cm , \fp_eval:n { #2 - 0.03 } cm ) rectangle
          ( \fp_eval:n { #1 + 0.13 } cm , \fp_eval:n { #2 + 0.03 } cm ) ;
        \exp_not:N \draw [ mriseq/break ]
          ( \fp_eval:n { #1 - 0.14 } cm , \fp_eval:n { #2 } cm ) --
          ( \fp_eval:n { #1 - 0.07 } cm , \fp_eval:n { #2 } cm ) --
          ( \fp_eval:n { #1 - 0.03 } cm , \fp_eval:n { #2 + 0.09 } cm ) --
          ( \fp_eval:n { #1 + 0.03 } cm , \fp_eval:n { #2 - 0.09 } cm ) --
          ( \fp_eval:n { #1 + 0.07 } cm , \fp_eval:n { #2 } cm ) --
          ( \fp_eval:n { #1 + 0.14 } cm , \fp_eval:n { #2 } cm ) ;
      }
  }
\cs_new_protected:Npn \__mriseq_break_slash:nn #1#2
  {
    \__mriseq_exec:e
      {
        \exp_not:N \fill [ mriseq-bg ]
          ( \fp_eval:n { #1 - 0.06 } cm , \fp_eval:n { #2 - 0.03 } cm ) rectangle
          ( \fp_eval:n { #1 + 0.06 } cm , \fp_eval:n { #2 + 0.03 } cm ) ;
        \exp_not:N \draw [ mriseq/break ]
          ( \fp_eval:n { #1 - 0.11 } cm , \fp_eval:n { #2 - 0.12 } cm ) --
          ( \fp_eval:n { #1 - 0.01 } cm , \fp_eval:n { #2 + 0.12 } cm )
          ( \fp_eval:n { #1 + 0.01 } cm , \fp_eval:n { #2 - 0.12 } cm ) --
          ( \fp_eval:n { #1 + 0.11 } cm , \fp_eval:n { #2 + 0.12 } cm ) ;
