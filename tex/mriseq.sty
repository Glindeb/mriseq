    \cs_set_eq:NN \phasetable \__mriseq_u_ptable:w
    \cs_set_eq:NN \readout    \__mriseq_u_adc:w
    \cs_set_eq:NN \fid        \__mriseq_u_fid:w
    \cs_set_eq:NN \echo       \__mriseq_u_echo:w
    \cs_set_eq:NN \waveform   \__mriseq_u_wave:w
    \cs_set_eq:NN \marker     \__mriseq_u_marker:w
    \cs_set_eq:NN \interval   \__mriseq_u_interval:w
    \cs_set_eq:NN \gap        \__mriseq_u_gap:w
    \cs_set_eq:NN \annotate   \__mriseq_u_tikz:w
    \cs_set_eq:NN \shadearea  \__mriseq_u_shade:w
    \cs_set_eq:NN \spinecho          \__mriseq_u_se:w
    \cs_set_eq:NN \gradientecho      \__mriseq_u_gre:w
    \cs_set_eq:NN \inversionrecovery \__mriseq_u_ir:w
    \cs_set_eq:NN \epi               \__mriseq_u_epi:w
    \cs_set_eq:NN \turbospinecho     \__mriseq_u_tse:w
    \cs_set_eq:NN \diffusionspinecho \__mriseq_u_dwse:w
