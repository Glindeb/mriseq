    % narrow diagrams (e.g. in subfigures) use the compact preset, unless
    % auto compact = 0pt; the user's keys are applied again on top of it
    \bool_lazy_and:nnT
      { \dim_compare_p:nNn { \l__mriseq_autocompact_tl } > { 0pt } }
      { \dim_compare_p:nNn { \l__mriseq_width_tl } < { \l__mriseq_autocompact_tl } }
      {
