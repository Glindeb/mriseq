    \__mriseq_q_interval:nnnn { TI } { \l__mriseq_q_tinv_fp } { \l__mriseq_q_t_fp }
      { \exp_not:V \l__mriseq_p_tilabel_tl }
    \int_compare:nNnT \l__mriseq_q_level_int > { 0 } { \int_decr:N \l__mriseq_q_level_int }
    \__mriseq_q_interval:nnnn { TE } { \l__mriseq_q_t_fp } { \l__mriseq_q_techo_fp }
      { \exp_not:V \l__mriseq_p_telabel_tl }
    \__mriseq_q_repeat:NN \__mriseq_q_ir_module:n \__mriseq_q_next_inversion:n
  }
\cs_new_protected:Npn \__mriseq_q_epi:
  {
    \__mriseq_q_begin:n { 90 }
    \fp_set:Nn \l__mriseq_q_tzero_fp
      { \l__mriseq_p_lead_fp + \l__mriseq_p_ramp_fp + \l__mriseq_p_rfdur_fp / 2 }
    \__mriseq_q_epi_module:n { \l__mriseq_q_tzero_fp }
    \bool_lazy_or:nnT { \l__mriseq_p_refocusing_bool } { \fp_compare_p:nNn \l__mriseq_p_b_fp > { 0 } }
      {
        \__mriseq_q_interval:nnnn { TE/2 } { \l__mriseq_q_t_fp } { \l__mriseq_q_tref_fp }
          { \exp_not:V \l__mriseq_p_tehalflabel_tl }
      }
    \__mriseq_q_interval:nnnn { ESP }
      { \l__mriseq_q_techo_fp } { \l__mriseq_q_techo_fp + \l__mriseq_q_esp_fp }
      { \exp_not:V \l__mriseq_p_esplabel_tl }
    \__mriseq_q_interval:nnnn { train }
      { \l__mriseq_q_ts_fp } { \l__mriseq_q_ts_fp + \l__mriseq_q_ny_int * \l__mriseq_q_esp_fp }
      { echo~train }
    \__mriseq_q_interval:nnnn { TE } { \l__mriseq_q_t_fp } { \l__mriseq_q_techo_fp }
      { \exp_not:V \l__mriseq_p_telabel_tl }
    \__mriseq_q_diff_intervals:
    \__mriseq_q_repeat:NN \__mriseq_q_epi_module:n \__mriseq_q_next_excitation:n
  }
\cs_new_protected:Npn \__mriseq_q_tse:
  {
    \__mriseq_q_begin:n { 90 }
    \fp_set:Nn \l__mriseq_q_tzero_fp
      { \l__mriseq_p_lead_fp + \l__mriseq_p_ramp_fp + \l__mriseq_p_rfdur_fp / 2 }
    \__mriseq_q_tse_module:n { \l__mriseq_q_tzero_fp }
    \int_compare:nNnT \l__mriseq_q_etl_int > { 1 }
      {
        \__mriseq_q_interval:nnnn { ESP }
          { \l__mriseq_q_t_fp + \l__mriseq_q_esp_fp } { \l__mriseq_q_t_fp + 2 * \l__mriseq_q_esp_fp }
          { \exp_not:V \l__mriseq_p_esplabel_tl }
      }
    \__mriseq_q_interval:nnnn { TE } { \l__mriseq_q_t_fp } { \l__mriseq_q_techo_fp }
      { \exp_not:V \l__mriseq_p_telabel_tl }
    \__mriseq_q_repeat:NN \__mriseq_q_tse_module:n \__mriseq_q_next_excitation:n
  }

