  { \cs_if_exist_use:c { __mriseq_compute_#1: } }

%  mean value of the current pulse shape over its duration -> #1
\prop_new:N \g__mriseq_mean_prop
\cs_new_protected:Npn \__mriseq_shape_mean:N #1
  {
    \tl_set:Ne \l__mriseq_tmp_tl
      { \l__mriseq_el_shape_tl | \l__mriseq_el_window_tl | \fp_eval:n { \l__mriseq_tbw_fp } }
    \prop_get:NVNTF \g__mriseq_mean_prop \l__mriseq_tmp_tl \l__mriseq_fill_tl
      { \fp_set:Nn #1 { \l__mriseq_fill_tl } }
      {
        \str_if_eq:VnTF \l__mriseq_el_shape_tl { hard }
          { \fp_set:Nn #1 { 1 } }
          {
            \fp_set:Nn #1 { 0 }
            \int_step_inline:nnn { 0 } { 64 }
              {
                \fp_add:Nn #1
                  { \use:c { __mriseq_shape_ \l__mriseq_el_shape_tl :n } { -0.5 + ##1 / 64 } }
              }
            \fp_set:Nn #1 { #1 / 65 }
          }
        \prop_gput:NVe \g__mriseq_mean_prop \l__mriseq_tmp_tl { \fp_eval:n {#1} }
      }
  }
\prg_generate_conditional_variant:Nnn \prop_get:NnN { NV } { TF }
\cs_new_protected:cpn { __mriseq_compute_rf: }
  {
    \tl_if_blank:VT \l__mriseq_el_shape_tl
      { \tl_set_eq:NN \l__mriseq_el_shape_tl \l__mriseq_shape_tl }
    \tl_if_blank:VT \l__mriseq_el_window_tl
      { \tl_set_eq:NN \l__mriseq_el_window_tl \l__mriseq_window_tl }
    \tl_if_blank:VT \l__mriseq_el_res_tl
      { \tl_set_eq:NN \l__mriseq_el_res_tl \l__mriseq_res_tl }
    \__mriseq_fp_set:NVV \l__mriseq_d_fp \l__mriseq_el_dur_tl \l__mriseq_rfdur_tl
    \__mriseq_resolve_start:nn { \l__mriseq_d_fp } { \l__mriseq_d_fp / 2 }
    \fp_set:Nn \l__mriseq_c_fp { \l__mriseq_s_fp + \l__mriseq_d_fp / 2 }
    \tl_if_blank:VTF \l__mriseq_el_amp_tl
      {
        \tl_if_blank:VTF \l__mriseq_el_flip_tl
          { \fp_set:Nn \l__mriseq_amp_fp { 1 } }
          {
            % B1 amplitude is proportional to  flip / (duration * mean shape).
            % Normalised so that a 180 degree pulse with the default
            % shape, window, tbw and duration has amplitude 1.
            \group_begin:
              \tl_set_eq:NN \l__mriseq_el_shape_tl \l__mriseq_shape_tl
              \tl_set_eq:NN \l__mriseq_el_window_tl \l__mriseq_window_tl
              \fp_set:Nn \l__mriseq_tbw_fp { \l__mriseq_tbw_tl }
              \__mriseq_shape_mean:N \l__mriseq_tmpb_fp
              \fp_set:Nn \l__mriseq_tmpb_fp { \l__mriseq_tmpb_fp * ( \l__mriseq_rfdur_tl ) }
              \exp_args:NNNe \group_end:
              \fp_set:Nn \l__mriseq_tmpb_fp { \fp_eval:n { \l__mriseq_tmpb_fp } }
            \__mriseq_fp_set:NVV \l__mriseq_tbw_fp \l__mriseq_el_tbw_tl \l__mriseq_tbw_tl
            \__mriseq_shape_mean:N \l__mriseq_tmpa_fp
            \fp_set:Nn \l__mriseq_amp_fp
              { (\l__mriseq_el_flip_tl) / 180 * \l__mriseq_tmpb_fp
                / ( \l__mriseq_d_fp * \l__mriseq_tmpa_fp ) }
          }
      }
      { \fp_set:Nn \l__mriseq_amp_fp { \l__mriseq_el_amp_tl } }
    \__mriseq_fp_set:NVV \l__mriseq_tbw_fp \l__mriseq_el_tbw_tl \l__mriseq_tbw_tl
    \fp_set:Nn \l__mriseq_max_fp { abs(\l__mriseq_amp_fp) }
  }

\cs_new_protected:cpn { __mriseq_compute_grad: }
  {
    \__mriseq_fp_set:NVV \l__mriseq_ru_fp \l__mriseq_el_ru_tl \l__mriseq_ramp_tl
    \__mriseq_fp_set:NVV \l__mriseq_rd_fp \l__mriseq_el_rd_tl \l__mriseq_ramp_tl
    % flat top
    \tl_if_blank:VTF \l__mriseq_el_flat_tl
      {
        \bool_lazy_and:nnTF
          { ! \tl_if_blank_p:V \l__mriseq_el_area_tl }
          { ! \tl_if_blank_p:V \l__mriseq_el_amp_tl }
          {
            \fp_set:Nn \l__mriseq_flat_fp
              { max( 0 , (\l__mriseq_el_area_tl) / (\l__mriseq_el_amp_tl)
                  - (\l__mriseq_ru_fp + \l__mriseq_rd_fp) / 2 ) }
          }
          {
            \tl_if_blank:VTF \l__mriseq_el_dur_tl
              { \fp_set:Nn \l__mriseq_flat_fp { 1 } }
              {
                \fp_set:Nn \l__mriseq_flat_fp
                  { max( 0 , (\l__mriseq_el_dur_tl) - \l__mriseq_ru_fp - \l__mriseq_rd_fp ) }
              }
          }
      }
      { \fp_set:Nn \l__mriseq_flat_fp { \l__mriseq_el_flat_tl } }
    % amplitude
    \tl_if_blank:VTF \l__mriseq_el_amp_tl
      {
        \tl_if_blank:VTF \l__mriseq_el_area_tl
          { \fp_set:Nn \l__mriseq_amp_fp { 1 } }
          {
            \fp_set:Nn \l__mriseq_amp_fp
              { (\l__mriseq_el_area_tl)
                / ( \l__mriseq_flat_fp + (\l__mriseq_ru_fp + \l__mriseq_rd_fp) / 2 ) }
          }
      }
      { \fp_set:Nn \l__mriseq_amp_fp { \l__mriseq_el_amp_tl } }
    \fp_set:Nn \l__mriseq_d_fp
      { \l__mriseq_ru_fp + \l__mriseq_flat_fp + \l__mriseq_rd_fp }
    \__mriseq_resolve_start:nn { \l__mriseq_d_fp }
      { \l__mriseq_ru_fp + \l__mriseq_flat_fp / 2 }
    \fp_set:Nn \l__mriseq_c_fp
      { \l__mriseq_s_fp + \l__mriseq_ru_fp + \l__mriseq_flat_fp / 2 }
    \fp_set:Nn \l__mriseq_area_fp
      { \l__mriseq_amp_fp * ( \l__mriseq_flat_fp + (\l__mriseq_ru_fp + \l__mriseq_rd_fp) / 2 ) }
    \fp_set:Nn \l__mriseq_max_fp { abs(\l__mriseq_amp_fp) }
  }
\cs_new_eq:cc { __mriseq_compute_ptable: } { __mriseq_compute_grad: }

\cs_new_protected:cpn { __mriseq_compute_adc: }
  {
    \tl_if_blank:VTF \l__mriseq_el_dur_tl
      {
        \bool_lazy_and:nnTF
          { ! \tl_if_blank_p:V \l__mriseq_el_samples_tl }
          { ! \tl_if_blank_p:V \l__mriseq_el_dwell_tl }
          { \fp_set:Nn \l__mriseq_d_fp { (\l__mriseq_el_samples_tl) * (\l__mriseq_el_dwell_tl) } }
          { \fp_set:Nn \l__mriseq_d_fp { 1 } }
      }
      { \fp_set:Nn \l__mriseq_d_fp { \l__mriseq_el_dur_tl } }
    \__mriseq_resolve_start:nn { \l__mriseq_d_fp } { \l__mriseq_d_fp / 2 }
    \fp_set:Nn \l__mriseq_c_fp { \l__mriseq_s_fp + \l__mriseq_d_fp / 2 }
    \fp_set:Nn \l__mriseq_max_fp { 1 }
    \fp_set:Nn \l__mriseq_amp_fp { 1 }
  }

\cs_new_protected:cpn { __mriseq_compute_fid: }
  {
    \__mriseq_fp_set:NVn \l__mriseq_ttwo_fp \l__mriseq_el_ttwo_tl { 1 }
    \__mriseq_fp_set:NVn \l__mriseq_d_fp \l__mriseq_el_dur_tl { 4 * \l__mriseq_ttwo_fp }
    \__mriseq_fp_set:NVn \l__mriseq_amp_fp \l__mriseq_el_amp_tl { 1 }
    \tl_if_blank:VT \l__mriseq_el_start_tl
      { \tl_set_eq:NN \l__mriseq_el_start_tl \l__mriseq_el_center_tl }
    \__mriseq_resolve_start:nn { \l__mriseq_d_fp } { 0 }
    \fp_set_eq:NN \l__mriseq_c_fp \l__mriseq_s_fp
    \fp_set:Nn \l__mriseq_max_fp { abs(\l__mriseq_amp_fp) }
  }

\cs_new_protected:cpn { __mriseq_compute_echo: }
  {
    \__mriseq_fp_set:NVn \l__mriseq_ttwo_fp \l__mriseq_el_ttwo_tl { 0.6 }
    \__mriseq_fp_set:NVn \l__mriseq_d_fp \l__mriseq_el_dur_tl { 8 * \l__mriseq_ttwo_fp }
    \__mriseq_fp_set:NVn \l__mriseq_amp_fp \l__mriseq_el_amp_tl { 1 }
    \__mriseq_resolve_start:nn { \l__mriseq_d_fp } { \l__mriseq_d_fp / 2 }
    \fp_set:Nn \l__mriseq_c_fp { \l__mriseq_s_fp + \l__mriseq_d_fp / 2 }
    \fp_set:Nn \l__mriseq_max_fp { abs(\l__mriseq_amp_fp) }
  }

\cs_new_protected:cpn { __mriseq_compute_wave: }
  {
    \fp_set:Nn \l__mriseq_s_fp { inf }
    \fp_set:Nn \l__mriseq_e_fp { -inf }
    \fp_set:Nn \l__mriseq_max_fp { 0 }
    \exp_args:NV \clist_map_inline:nn \l__mriseq_el_points_tl
      { \__mriseq_wave_extent:w ##1 \q_stop }
    \fp_compare:nNnT \l__mriseq_s_fp = { inf }
      { \fp_set:Nn \l__mriseq_s_fp { 0 } \fp_set:Nn \l__mriseq_e_fp { 0 } }
  }
\cs_new_protected:Npn \__mriseq_wave_extent:w #1 / #2 \q_stop
  {
    \fp_set:Nn \l__mriseq_s_fp { min( \l__mriseq_s_fp , #1 ) }
    \fp_set:Nn \l__mriseq_e_fp { max( \l__mriseq_e_fp , #1 ) }
    \fp_set:Nn \l__mriseq_max_fp { max( \l__mriseq_max_fp , abs(#2) ) }
  }

% =========================================================================
%  7. Collecting items
% =========================================================================
\cs_new_protected:Npn \__mriseq_push:nnn #1#2#3
  { \tl_gput_right:Nn \g__mriseq_items_tl { \__mriseq_item:nnn {#1} {#2} {#3} } }
\cs_new_protected:Npn \__mriseq_push:nne #1#2#3
  { \tl_gput_right:Ne \g__mriseq_items_tl { \exp_not:N \__mriseq_item:nnn {#1} {#2} {#3} } }

\cs_new_protected:Npn \__mriseq_group_of:n #1
  {
    \tl_if_exist:cTF { l__mriseq_row_#1_group_tl }
      { \tl_set_eq:Nc \l__mriseq_group_tl { l__mriseq_row_#1_group_tl } }
      { \tl_set:Nn \l__mriseq_group_tl {#1} }
    \tl_if_blank:VF \l__mriseq_el_group_tl
      { \tl_set_eq:NN \l__mriseq_group_tl \l__mriseq_el_group_tl }
  }

% ---- measure pass -------------------------------------------------------
\cs_new_protected:Npn \__mriseq_measure_item:nnn #1#2#3
  {
    \group_begin:
      \keys_set:nn { mriseq / el } {#3}
      \str_case:nnF {#1}
        {
          { marker }
            {
              \tl_if_blank:VF \l__mriseq_el_label_tl
                { \bool_gset_true:N \g__mriseq_markerlabel_bool }
            }
          { interval }
            {
              \str_case:VnF \l__mriseq_el_pos_tl
                {
                  { top }
                    { \int_gset:Nn \g__mriseq_toplevels_int
                        { \int_max:nn { \g__mriseq_toplevels_int } { \l__mriseq_el_level_tl } } }
                  { bottom }
                    { \int_gset:Nn \g__mriseq_botlevels_int
                        { \int_max:nn { \g__mriseq_botlevels_int } { \l__mriseq_el_level_tl } } }
                }
                { }
            }
          { gap }
            {
              \seq_gput_right:Ne \g__mriseq_gaps_seq
                { { \fp_eval:n { \l__mriseq_el_from_tl } } { \fp_eval:n { \l__mriseq_el_to_tl } } }
            }
          { tikz } { }
          { shade } { }
        }
        {
          \__mriseq_compute:n {#1}
          \bool_if:NT \l__mriseq_el_occupy_bool
            {
              \bool_gset_true:N \g__mriseq_any_bool
              \fp_gset:Nn \g__mriseq_tfirst_fp { min( \g__mriseq_tfirst_fp , \l__mriseq_s_fp ) }
              \fp_gset:Nn \g__mriseq_tlast_fp  { max( \g__mriseq_tlast_fp , \l__mriseq_e_fp ) }
              \seq_gput_right:Ne \g__mriseq_occ_seq
                { { \fp_eval:n { \l__mriseq_s_fp } } { \fp_eval:n { \l__mriseq_e_fp } } }
            }
          \__mriseq_group_of:n {#2}
          \prop_get:NVNF \g__mriseq_max_prop \l__mriseq_group_tl \l__mriseq_tmp_tl
            { \tl_set:Nn \l__mriseq_tmp_tl { 0 } }
          \prop_gput:NVe \g__mriseq_max_prop \l__mriseq_group_tl
            { \fp_eval:n { max( \l__mriseq_tmp_tl , \l__mriseq_max_fp ) } }
          \prop_get:NeNF \g__mriseq_max_prop { @row@ #2 } \l__mriseq_tmp_tl
            { \tl_set:Nn \l__mriseq_tmp_tl { 0 } }
          \prop_gput:Nee \g__mriseq_max_prop { @row@ #2 }
            { \fp_eval:n { max( \l__mriseq_tmp_tl , \l__mriseq_max_fp ) } }
        }
    \group_end:
  }
\cs_generate_variant:Nn \prop_get:NnNF { NV }
\cs_generate_variant:Nn \prop_gput:Nnn { NVe , Nee }
\cs_generate_variant:Nn \prop_get:NnNF { Ne }
\cs_generate_variant:Nn \str_case:nnF { V }

% =========================================================================
%  8. Time mapping (with compressed breaks) and coordinates
% =========================================================================
\cs_new:Npn \__mriseq_map:n #1
  { ( (#1) \seq_map_tokens:Nn \l__mriseq_breaks_seq { \__mriseq_map_aux:nn {#1} } ) }
\cs_new:Npn \__mriseq_map_aux:nn #1#2 { \__mriseq_map_aux:nnn {#1} #2 }
\cs_new:Npn \__mriseq_map_aux:nnn #1#2#3
  { - ( min( max( (#1) , #2 ) , #3 ) - #2 ) * ( 1 - \l__mriseq_g_fp / ( #3 - #2 ) ) }
\cs_new:Npn \__mriseq_xe:n #1
  {
    \bool_if:NTF \l__mriseq_lin_bool
      { (#1) * \l__mriseq_k_fp + \l__mriseq_xoff_fp }
      { ( \__mriseq_map:n {#1} - \l__mriseq_mzero_fp ) * \l__mriseq_k_fp }
  }
\bool_new:N \l__mriseq_lin_bool
\fp_new:N \l__mriseq_xoff_fp
%  Use a linear time mapping for the current element if it does not touch a break
\cs_new_protected:Npn \__mriseq_try_linear:
  {
    \bool_set_false:N \l__mriseq_lin_bool
    \bool_set_true:N \l_tmpb_bool
    \seq_map_inline:Nn \l__mriseq_breaks_seq
      {
        \fp_compare:nT
          { \use_i:nn ##1 < \l__mriseq_e_fp + 0.01 && \use_ii:nn ##1 > \l__mriseq_s_fp - 0.01 }
          { \bool_set_false:N \l_tmpb_bool \seq_map_break: }
      }
    \bool_if:NT \l_tmpb_bool
      {
        \fp_set:Nn \l__mriseq_xoff_fp
          { \__mriseq_xe:n { \l__mriseq_s_fp } - \l__mriseq_s_fp * \l__mriseq_k_fp }
        \bool_set_true:N \l__mriseq_lin_bool
      }
  }
\cs_new:Npn \__mriseq_x:n #1
  { \fp_eval:n { round( \__mriseq_xe:n {#1} , 4 ) } }
\cs_new:Npn \__mriseq_y:n #1
  { \fp_eval:n { round( \l__mriseq_cur_yb_tl + (#1) * \l__mriseq_cur_sc_tl , 4 ) } }
\cs_new:Npn \__mriseq_pt:nn #1#2
  { ( \__mriseq_x:n {#1} cm , \__mriseq_y:n {#2} cm ) }

\cs_new_protected:Npn \__mriseq_use_row:n #1
  {
    \tl_set_eq:Nc \l__mriseq_cur_yb_tl { l__mriseq_row_#1_yb_tl }
    \tl_set_eq:Nc \l__mriseq_cur_sc_tl { l__mriseq_row_#1_sc_tl }
    \tl_set_eq:Nc \l__mriseq_cur_ybot_tl { l__mriseq_row_#1_ybot_tl }
    \tl_set:Ne \l__mriseq_cur_h_tl
      { \fp_eval:n { \tl_use:c { l__mriseq_row_#1_ytop_tl } - \tl_use:c { l__mriseq_row_#1_ybot_tl } } }
  }

% ---- auto breaks --------------------------------------------------------
\cs_new_protected:Npn \__mriseq_compute_breaks:
  {
    \seq_clear:N \l__mriseq_breaks_seq
    \seq_map_inline:Nn \g__mriseq_gaps_seq
      { \seq_put_right:Nn \l__mriseq_breaks_seq {##1} }
    \bool_if:NT \l__mriseq_compress_bool
      {
        \seq_set_eq:NN \l__mriseq_tmp_seq \g__mriseq_occ_seq
        \seq_sort:Nn \l__mriseq_tmp_seq
          {
            \fp_compare:nNnTF { \use_i:nn ##1 } > { \use_i:nn ##2 }
              { \sort_return_swapped: } { \sort_return_same: }
          }
        \fp_set:Nn \l__mriseq_tmpa_fp { -inf }   % end of merged block so far
        \seq_map_inline:Nn \l__mriseq_tmp_seq
          {
            \fp_set:Nn \l__mriseq_tmpb_fp { \use_i:nn ##1 }
            \bool_lazy_and:nnT
              { \fp_compare_p:nNn \l__mriseq_tmpa_fp > { -inf } }
              { \fp_compare_p:nNn { \l__mriseq_tmpb_fp - \l__mriseq_tmpa_fp } > \l__mriseq_threshold_fp }
              {
                \seq_put_right:Ne \l__mriseq_breaks_seq
                  {
                    { \fp_eval:n { \l__mriseq_tmpa_fp + \l__mriseq_margin_fp } }
                    { \fp_eval:n { \l__mriseq_tmpb_fp - \l__mriseq_margin_fp } }
                  }
              }
            \fp_set:Nn \l__mriseq_tmpa_fp { max( \l__mriseq_tmpa_fp , \use_ii:nn ##1 ) }
          }
      }
    % sort and merge overlapping breaks
    \seq_sort:Nn \l__mriseq_breaks_seq
      {
        \fp_compare:nNnTF { \use_i:nn ##1 } > { \use_i:nn ##2 }
          { \sort_return_swapped: } { \sort_return_same: }
      }
    \seq_clear:N \l__mriseq_tmp_seq
    \fp_set:Nn \l__mriseq_tmpa_fp { nan }
    \seq_map_inline:Nn \l__mriseq_breaks_seq
      {
        \fp_if_nan:nTF { \l__mriseq_tmpa_fp }
          {
            \fp_set:Nn \l__mriseq_tmpa_fp { \use_i:nn ##1 }
            \fp_set:Nn \l__mriseq_tmpb_fp { \use_ii:nn ##1 }
          }
          {
            \fp_compare:nNnTF { \use_i:nn ##1 } > \l__mriseq_tmpb_fp
              {
                \seq_put_right:Ne \l__mriseq_tmp_seq
                  { { \fp_eval:n { \l__mriseq_tmpa_fp } } { \fp_eval:n { \l__mriseq_tmpb_fp } } }
                \fp_set:Nn \l__mriseq_tmpa_fp { \use_i:nn ##1 }
                \fp_set:Nn \l__mriseq_tmpb_fp { \use_ii:nn ##1 }
              }
              { \fp_set:Nn \l__mriseq_tmpb_fp { max( \l__mriseq_tmpb_fp , \use_ii:nn ##1 ) } }
          }
      }
    \fp_if_nan:nF { \l__mriseq_tmpa_fp }
      {
        \seq_put_right:Ne \l__mriseq_tmp_seq
          { { \fp_eval:n { \l__mriseq_tmpa_fp } } { \fp_eval:n { \l__mriseq_tmpb_fp } } }
      }
    \seq_set_eq:NN \l__mriseq_breaks_seq \l__mriseq_tmp_seq
    % keep only breaks inside the time window, clipped to it
    \seq_clear:N \l__mriseq_tmp_seq
    \seq_map_inline:Nn \l__mriseq_breaks_seq
      {
        \fp_set:Nn \l__mriseq_tmpa_fp { max( \use_i:nn ##1 , \l__mriseq_tmin_fp ) }
        \fp_set:Nn \l__mriseq_tmpb_fp { min( \use_ii:nn ##1 , \l__mriseq_tmax_fp ) }
        \fp_compare:nNnT { \l__mriseq_tmpb_fp - \l__mriseq_tmpa_fp } > { 0 }
          {
            \seq_put_right:Ne \l__mriseq_tmp_seq
              { { \fp_eval:n { \l__mriseq_tmpa_fp } } { \fp_eval:n { \l__mriseq_tmpb_fp } } }
          }
      }
    \seq_set_eq:NN \l__mriseq_breaks_seq \l__mriseq_tmp_seq
  }

% =========================================================================
%  9. Layout
% =========================================================================
\cs_new_protected:Npn \__mriseq_layout:
  {
    % ---- time window
    \bool_if:NTF \g__mriseq_any_bool
      {
        \__mriseq_fp_set:NVn \l__mriseq_tmin_fp \l__mriseq_tmin_tl
          { \g__mriseq_tfirst_fp - \l__mriseq_pad_fp }
        \__mriseq_fp_set:NVn \l__mriseq_tmax_fp \l__mriseq_tmax_tl
          { \g__mriseq_tlast_fp + \l__mriseq_pad_fp }
      }
      {
        \__mriseq_fp_set:NVn \l__mriseq_tmin_fp \l__mriseq_tmin_tl { 0 }
        \__mriseq_fp_set:NVn \l__mriseq_tmax_fp \l__mriseq_tmax_tl { 10 }
      }
    \__mriseq_compute_breaks:
    % ---- horizontal scale
    \fp_set:Nn \l__mriseq_tmpa_fp { \l__mriseq_tmax_fp - \l__mriseq_tmin_fp }
    \seq_map_inline:Nn \l__mriseq_breaks_seq
      { \fp_sub:Nn \l__mriseq_tmpa_fp { \use_ii:nn ##1 - \use_i:nn ##1 } }
    \fp_set:Nn \l__mriseq_tmpb_fp
      { \seq_count:N \l__mriseq_breaks_seq * \dim_to_decimal_in_unit:nn { \l__mriseq_breakwidth_dim } { 1cm } }
    \tl_if_blank:VTF \l__mriseq_xscale_tl
      {
        \fp_set:Nn \l__mriseq_width_fp
          {
            \dim_to_decimal_in_unit:nn
              { \l__mriseq_width_tl - \bool_if:NTF \l__mriseq_rowlabels_bool
                  { \l__mriseq_labelwidth_dim } { 0pt }
                - \bool_lazy_or:nnTF
                    { \str_if_eq_p:Vn \l__mriseq_kspace_tl { none } }
                    { \str_if_eq_p:Vn \l__mriseq_kspace_tl { below } }
                    { 0pt }
                    { ( \l__mriseq_kspace_size_dim + \l__mriseq_kspace_gap_dim ) } } { 1cm }
          }
        \fp_set:Nn \l__mriseq_k_fp
          { (\l__mriseq_width_fp - \l__mriseq_tmpb_fp) / \l__mriseq_tmpa_fp }
      }
      {
        \fp_set:Nn \l__mriseq_k_fp
          { \dim_to_decimal_in_unit:nn { \l__mriseq_xscale_tl } { 1cm } }
        \fp_set:Nn \l__mriseq_width_fp
          { \l__mriseq_k_fp * \l__mriseq_tmpa_fp + \l__mriseq_tmpb_fp }
      }
    \fp_set:Nn \l__mriseq_g_fp
      { \dim_to_decimal_in_unit:nn { \l__mriseq_breakwidth_dim } { 1cm } / \l__mriseq_k_fp }
    \fp_set:Nn \l__mriseq_mzero_fp { 0 }
    \fp_set:Nn \l__mriseq_mzero_fp { \__mriseq_map:n { \l__mriseq_tmin_fp } }
    % ---- rows
    \seq_clear:N \l__mriseq_vrows_seq
    \fp_set:Nn \l__mriseq_tmpa_fp { 0 }
    \clist_map_inline:Nn \l__mriseq_rows_clist
      {
        \tl_if_exist:cTF { l__mriseq_row_##1_label_tl }
          {
            \seq_put_right:Nn \l__mriseq_vrows_seq {##1}
            \fp_set:Nn \l__mriseq_tmpb_fp
              { \l__mriseq_rowscale_fp *
                \dim_to_decimal_in_unit:nn { \tl_use:c { l__mriseq_row_##1_height_tl } } { 1cm } }
            \tl_set:ce { l__mriseq_row_##1_ytop_tl } { \fp_eval:n { \l__mriseq_tmpa_fp } }
            \fp_sub:Nn \l__mriseq_tmpa_fp { \l__mriseq_tmpb_fp }
            \tl_set:ce { l__mriseq_row_##1_ybot_tl } { \fp_eval:n { \l__mriseq_tmpa_fp } }
            \tl_set:ce { l__mriseq_row_##1_yb_tl }
              { \fp_eval:n { \l__mriseq_tmpa_fp + \tl_use:c { l__mriseq_row_##1_base_tl } * \l__mriseq_tmpb_fp } }
            % amplitude scale
            \tl_set_eq:Nc \l__mriseq_group_tl { l__mriseq_row_##1_group_tl }
            \bool_lazy_and:nnT { \l__mriseq_gradrow_bool }
              { \str_if_eq_p:Vn \l__mriseq_group_tl { grad } }
              { \tl_set:Nn \l__mriseq_group_tl { @row@ ##1 } }
            \__mriseq_group_max:V \l__mriseq_group_tl
            % fraction of the half row used by the largest amplitude
            \str_if_eq:VnTF \l__mriseq_ampfill_tl { auto }
              {
                \fp_set:Nn \l__mriseq_ampfill_fp
                  {
                    \bool_lazy_and:nnTF
                      { \bool_lazy_or_p:nn { \l__mriseq_amplabels_bool } { \l__mriseq_arealabels_bool } }
                      { ! \str_if_eq_p:ee { \tl_use:c { l__mriseq_row_##1_group_tl } } { rf } }
                      { 0.6 } { 0.85 }
                  }
              }
              { \fp_set:Nn \l__mriseq_ampfill_fp { \l__mriseq_ampfill_tl } }
            \tl_set:ce { l__mriseq_row_##1_sc_tl }
              {
                \fp_eval:n
                  { (1 - \tl_use:c { l__mriseq_row_##1_base_tl }) * \l__mriseq_tmpb_fp
                    * \l__mriseq_ampfill_fp / \l__mriseq_tmpc_fp }
              }
          }
