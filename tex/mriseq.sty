%  shade the pairs of equal gradient areas (slice rephasing, read prephasing)
\cs_new_protected:Npn \__mriseq_q_equal_areas:
  {
    \bool_lazy_and:nnT { \l__mriseq_p_equal_bool } { \int_compare_p:nNn \l__mriseq_q_rep_int = { 0 } }
      {
        \__mriseq_push:nne { shade } { gz }
          { from = \__mriseq_f:n { \l__mriseq_q_t_fp } ,
            to = \__mriseq_f:n { \l__mriseq_q_t_fp + \l__mriseq_p_rfdur_fp / 2 + \l__mriseq_p_ramp_fp } , style = A }
        \__mriseq_push:nne { shade } { gz }
          { from = \__mriseq_f:n { \l__mriseq_q_p_fp } , to = \__mriseq_f:n { \l__mriseq_q_p_fp + \l__mriseq_p_prep_fp } ,
            style = A }
        \__mriseq_push:nne { shade } { gx }
          { from = \__mriseq_f:n { \l__mriseq_q_p_fp } , to = \__mriseq_f:n { \l__mriseq_q_p_fp + \l__mriseq_p_prep_fp } ,
            style = B }
        \__mriseq_push:nne { shade } { gx }
          { from = \__mriseq_f:n { \l__mriseq_q_techo_fp - \l__mriseq_q_tacq_fp / 2 - \l__mriseq_p_ramp_fp } ,
            to = \__mriseq_f:n { \l__mriseq_q_techo_fp } , style = B }
      }
  }

