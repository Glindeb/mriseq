% ---- RF pulse -----------------------------------------------------------
\cs_new:Npn \__mriseq_window:n #1
  { \cs_if_exist_use:cF { __mriseq_window_ \l__mriseq_el_window_tl :n } { 1 \use_none:n } {#1} }
\cs_new:Npn \__mriseq_window_hamming:n #1 { ( 0.54 + 0.46 * cos( 2 * pi * (#1) ) ) }
\cs_new:Npn \__mriseq_window_hann:n #1 { ( 0.5 + 0.5 * cos( 2 * pi * (#1) ) ) }
\cs_new:Npn \__mriseq_window_hanning:n #1 { ( 0.5 + 0.5 * cos( 2 * pi * (#1) ) ) }
