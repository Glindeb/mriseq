\cs_new_protected:cpn { __mriseq_draw_rf: }
  {
    % role -> colour
    \tl_if_blank:VT \l__mriseq_el_role_tl
      {
        \bool_lazy_and:nnTF
          { ! \tl_if_blank_p:V \l__mriseq_el_flip_tl }
          { \fp_compare_p:nNn { \l__mriseq_el_flip_tl } > { 135 } }
          { \tl_set:Nn \l__mriseq_el_role_tl { refocus } }
          { \tl_set:Nn \l__mriseq_el_role_tl { excite } }
      }
    \__mriseq_colors:nNN { mriseq-rf- \l__mriseq_el_role_tl } \l__mriseq_rfmix_tl \l__mriseq_rffill_tl
    \tl_clear:N \l__mriseq_path_tl
    \str_if_eq:VnTF \l__mriseq_el_shape_tl { hard }
      {
        \tl_set:Ne \l__mriseq_path_tl
          {
            -- \__mriseq_pt:nn { \l__mriseq_s_fp } { \l__mriseq_amp_fp }
            -- \__mriseq_pt:nn { \l__mriseq_e_fp } { \l__mriseq_amp_fp }
          }
      }
      {
        % a smooth curve through the samples (resolution = number of intervals)
        \int_set:Nn \l__mriseq_n_int { \l__mriseq_el_res_tl }
        \int_step_inline:nnn { 0 } { \l__mriseq_n_int }
          {
            \fp_set:Nn \l__mriseq_tmpa_fp { -0.5 + ##1 / \l__mriseq_n_int }
            \tl_put_right:Ne \l__mriseq_path_tl
              {
                \__mriseq_pt:nn
                  { \l__mriseq_c_fp + \l__mriseq_tmpa_fp * \l__mriseq_d_fp }
                  { \l__mriseq_amp_fp * \use:c { __mriseq_shape_ \l__mriseq_el_shape_tl :n } { \l__mriseq_tmpa_fp } }
              }
          }
        \tl_set:Ne \l__mriseq_path_tl
          { -- plot [ smooth , tension = 0.5 ] coordinates { \exp_not:V \l__mriseq_path_tl } }
      }
    \__mriseq_exec:e
      {
        \exp_not:N \path [ mriseq/rf~fill , fill = \l__mriseq_fill_tl ]
          \__mriseq_pt:nn { \l__mriseq_s_fp } { 0 }
          \exp_not:V \l__mriseq_path_tl
          -- \__mriseq_pt:nn { \l__mriseq_e_fp } { 0 } -- cycle ;
        \exp_not:N \draw [ mriseq/rf , draw = \l__mriseq_col_tl , \exp_not:V \l__mriseq_el_style_tl ]
          \__mriseq_pt:nn { \l__mriseq_s_fp } { 0 }
          \exp_not:V \l__mriseq_path_tl
          -- \__mriseq_pt:nn { \l__mriseq_e_fp } { 0 } ;
      }
    % label
    \tl_if_blank:VTF \l__mriseq_el_label_tl
      {
        \bool_lazy_and:nnT
          { \l__mriseq_fliplabels_bool }
          { ! \tl_if_blank_p:V \l__mriseq_el_flip_tl }
          {
            \tl_set:Ne \l__mriseq_el_label_tl
              {
                $ \exp_not:V \l__mriseq_el_flip_tl ^ { \exp_not:N \circ }
                \tl_if_blank:VF \l__mriseq_el_phase_tl
                  { \c_math_subscript_token { \exp_not:V \l__mriseq_el_phase_tl } } $
              }
          }
      }
      { }
    \tl_if_blank:VF \l__mriseq_el_label_tl
      {
        \__mriseq_exec:e
          {
            \exp_not:N \node [ mriseq/flip~label , anchor = south ]
              at \__mriseq_pt:nn { \l__mriseq_c_fp } { \fp_eval:n { max( \l__mriseq_amp_fp , 0 ) } }
              { \exp_not:V \l__mriseq_el_label_tl } ;
          }
      }
  }

% ---- trapezoid gradient -------------------------------------------------
%  area of the trapezoid between its start and time #1
\cs_new:Npn \__mriseq_trap_area:n #1
  {
    \l__mriseq_amp_fp *
    (
      ( (#1) <= \l__mriseq_s_fp ) ? 0 :
      ( (#1) <= \l__mriseq_s_fp + \l__mriseq_ru_fp ) ?
          ( (#1) - \l__mriseq_s_fp ) ^ 2 / ( 2 * max( \l__mriseq_ru_fp , 1e-9 ) ) :
      ( (#1) <= \l__mriseq_s_fp + \l__mriseq_ru_fp + \l__mriseq_flat_fp ) ?
          ( \l__mriseq_ru_fp / 2 + (#1) - \l__mriseq_s_fp - \l__mriseq_ru_fp ) :
      ( (#1) < \l__mriseq_e_fp ) ?
          ( \l__mriseq_ru_fp / 2 + \l__mriseq_flat_fp + \l__mriseq_rd_fp / 2
            - ( \l__mriseq_e_fp - (#1) ) ^ 2 / ( 2 * max( \l__mriseq_rd_fp , 1e-9 ) ) ) :
      ( \l__mriseq_ru_fp / 2 + \l__mriseq_flat_fp + \l__mriseq_rd_fp / 2 )
    )
  }

\cs_new_protected:Npn \__mriseq_trap_path:n #1
  {
    \tl_set:Ne \l__mriseq_path_tl
      {
        \__mriseq_pt:nn { \l__mriseq_s_fp } { 0 }
        -- \__mriseq_pt:nn { \l__mriseq_s_fp + \l__mriseq_ru_fp } { #1 }
        -- \__mriseq_pt:nn { \l__mriseq_s_fp + \l__mriseq_ru_fp + \l__mriseq_flat_fp } { #1 }
        -- \__mriseq_pt:nn { \l__mriseq_e_fp } { 0 }
      }
  }

%  Value labels.  "outside" labels sit on the background and get a backing in
%  the background colour, so that lines behind them are cleanly interrupted;
%  "inside" labels sit completely inside a filled shape.
\cs_new_protected:Npn \__mriseq_value_node:nnnn #1#2#3#4
  { \__mriseq_value_node:nnnnn {#1} {#2} {#3} {#4} { mriseq/value~outside } }
\cs_new_protected:Npn \__mriseq_value_node:nnnnn #1#2#3#4#5
  % #1 time, #2 amplitude, #3 anchor, #4 text, #5 style
  {
    \bool_if:NTF \l__mriseq_avoid_bool
      {
        \group_begin:
          \__mriseq_measure:n {#4}
          \fp_set:Nn \l__mriseq_tmpa_fp { \__mriseq_x:n {#1} }
          \fp_set:Nn \l__mriseq_tmpb_fp { \__mriseq_y:n {#2} }
          \__mriseq_label_box:n {#3}
          % keep the label inside the time window: shift it horizontally
          \fp_set:Nn \l__mriseq_tmpc_fp
            {
              max( 0 , - \tl_item:Nn \l__mriseq_box_tl { 1 } )
              - max( 0 , \tl_item:Nn \l__mriseq_box_tl { 3 } - \l__mriseq_width_fp )
            }
          \fp_compare:nNnF \l__mriseq_tmpc_fp = { 0 }
            {
              \fp_add:Nn \l__mriseq_tmpa_fp { \l__mriseq_tmpc_fp }
              \__mriseq_label_box:n {#3}
            }
          \__mriseq_box_free:TF
            {
              \seq_gput_right:Ne \g__mriseq_labbox_seq { \l__mriseq_box_tl }
              \__mriseq_exec:e
                {
                  \exp_not:N \node [ mriseq/value , #5 , anchor = #3 ,
                                     xshift = \fp_eval:n { \l__mriseq_tmpc_fp } cm ]
                    at \__mriseq_pt:nn {#1} {#2} {#4} ;
                }
            }
            { \msg_info:nnee { mriseq } { label-dropped } { \tl_to_str:V \l__mriseq_lab_tl } { \l__mriseq_box_tl ~ idx~\int_use:N \g__mriseq_idx_int } }
        \group_end:
      }
      {
        \__mriseq_exec:e
          {
            \exp_not:N \node [ mriseq/value , #5 , anchor = #3 ]
              at \__mriseq_pt:nn {#1} {#2} {#4} ;
          }
      }
  }
