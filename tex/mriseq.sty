% =========================================================================
% 10b. k-space: k(t) rows and a k-space trajectory panel
% =========================================================================
%  k(t) = gammabar * integral G dt  (gammabar in kHz/mT, G in mT/m, t in ms -> 1/m)
%  An excitation pulse sets k to 0 at its centre, a refocusing (or inversion)
%  pulse mirrors k -> -k at its centre.  Gradients on the rows gx, gy, gz give
%  kx, ky, kz.  A phase-encoding table contributes its highlighted step
%  (\texttt{highlight}) or, without one, its outermost step.
\seq_new:N \g__mriseq_k_pieces_seq
\seq_new:N \g__mriseq_k_times_seq
\seq_new:N \g__mriseq_k_events_seq
\seq_new:N \g__mriseq_k_adc_seq
\seq_new:N \l__mriseq_k_t_seq
\int_new:N \l__mriseq_k_n_int
\fp_new:N \l__mriseq_k_max_fp
\fp_new:N \g__mriseq_k_maxx_fp
\fp_new:N \g__mriseq_k_maxy_fp
\fp_new:N \g__mriseq_k_maxz_fp
\tl_new:N \l__mriseq_kspace_tl
\dim_new:N \l__mriseq_kspace_size_dim
\dim_new:N \l__mriseq_kspace_gap_dim
\tl_new:N \l__mriseq_kspace_title_tl
\bool_new:N \l__mriseq_k_needed_bool
\tl_new:N \g__mriseq_k_panel_tl     % list of segments  {kind}{t1}{t2}{kx1}{ky1}{kx2}{ky2}
\keys_define:nn { mriseq }
  {
    kspace       .tl_set:N = \l__mriseq_kspace_tl ,
    kspace       .initial:n = none ,
    kspace       .default:n = right ,
    kspace~size  .dim_set:N = \l__mriseq_kspace_size_dim ,
    kspace~size  .initial:n = 3.6cm ,
    kspace~gap   .dim_set:N = \l__mriseq_kspace_gap_dim ,
    kspace~gap   .initial:n = 0.8cm ,
    kspace~title .tl_set:N = \l__mriseq_kspace_title_tl ,
    kspace~title .initial:n = {} ,
    kspace~isotropic .bool_set:N = \l__mriseq_kspace_iso_bool ,
    k~color      .code:n = \__mriseq_colorkey:nn { mriseq-k } {#1} ,
  }
\colorlet{mriseq-k}{mriseq-phase}

\cs_new:Npn \__mriseq_kv:nn #1#2 { \cs:w l__mriseq_kv_#1_ \int_eval:n {#2} _tl \cs_end: }
\cs_new_protected:Npn \__mriseq_kv_set:nnn #1#2#3
  { \cs_set_nopar:cpe { l__mriseq_kv_#1_ \int_eval:n {#2} _tl } { \fp_eval:n {#3} } }
\cs_generate_variant:Nn \__mriseq_kv_set:nnn { nen }

\cs_new_protected:Npn \__mriseq_k_axis:nN #1#2
  % row -> axis letter (or empty)
  {
    \str_case:nnF {#1}
      { { gx } { \tl_set:Nn #2 { x } } { gy } { \tl_set:Nn #2 { y } } { gz } { \tl_set:Nn #2 { z } } }
      { \tl_clear:N #2 }
  }
\cs_new_protected:Npn \__mriseq_k_addtime:n #1
  { \seq_gput_right:Ne \g__mriseq_k_times_seq { \fp_eval:n {#1} } }

%  collect gradients, RF events and ADC windows
\cs_new_protected:Npn \__mriseq_k_collect:nnn #1#2#3
  {
    \group_begin:
      \keys_set:nn { mriseq / el } {#3}
      \str_case:nn {#1}
        {
          { grad }   { \__mriseq_k_collect_trap:nnn {#1} {#2} { 1 } }
          { ptable }
            {
              \__mriseq_k_collect_trap:nnn {#1} {#2}
                { \tl_if_blank:VTF \l__mriseq_el_highlight_tl { 1 } { \l__mriseq_el_highlight_tl } }
            }
          { wave }
            {
              \__mriseq_k_axis:nN {#2} \l__mriseq_tmp_tl
              \tl_if_blank:VF \l__mriseq_tmp_tl
                {
                  \tl_clear:N \l__mriseq_path_tl
                  \exp_args:NV \clist_map_inline:nn \l__mriseq_el_points_tl
                    { \__mriseq_k_wavept:w ##1 \q_stop }
                  \seq_gput_right:Ne \g__mriseq_k_pieces_seq
                    { { \l__mriseq_tmp_tl } { \exp_not:V \l__mriseq_path_tl } }
                }
            }
          { rf }
            {
              \__mriseq_compute:n { rf }
              \tl_if_blank:VT \l__mriseq_el_role_tl
                {
                  \bool_lazy_and:nnTF
                    { ! \tl_if_blank_p:V \l__mriseq_el_flip_tl }
                    { \fp_compare_p:nNn { \l__mriseq_el_flip_tl } > { 135 } }
                    { \tl_set:Nn \l__mriseq_el_role_tl { refocus } }
                    { \tl_set:Nn \l__mriseq_el_role_tl { excite } }
                }
              \seq_gput_right:Ne \g__mriseq_k_events_seq
                {
                  { \fp_eval:n { \l__mriseq_c_fp } }
                  { \str_if_eq:VnTF \l__mriseq_el_role_tl { excite } { 1 } { 2 } }
                }
              \__mriseq_k_addtime:n { \l__mriseq_c_fp }
            }
          { adc }
            {
              \__mriseq_compute:n { adc }
              \seq_gput_right:Ne \g__mriseq_k_adc_seq
                { { \fp_eval:n { \l__mriseq_s_fp } } { \fp_eval:n { \l__mriseq_e_fp } } }
              \__mriseq_k_addtime:n { \l__mriseq_s_fp }
              \__mriseq_k_addtime:n { \l__mriseq_e_fp }
            }
        }
    \group_end:
  }
\cs_new_protected:Npn \__mriseq_k_wavept:w #1 / #2 \q_stop
  {
    \tl_put_right:Ne \l__mriseq_path_tl { { \fp_eval:n {#1} } { \fp_eval:n {#2} } }
    \__mriseq_k_addtime:n {#1}
  }
\cs_new_protected:Npn \__mriseq_k_collect_trap:nnn #1#2#3
  {
    \__mriseq_k_axis:nN {#2} \l__mriseq_tmp_tl
    \tl_if_blank:VF \l__mriseq_tmp_tl
      {
        \__mriseq_compute:n {#1}
        \fp_set:Nn \l__mriseq_tmpa_fp { \l__mriseq_amp_fp * (#3) }
        % corners plus points on the ramps (k is quadratic there)
        \tl_clear:N \l__mriseq_path_tl
        \int_step_inline:nnn { 0 } { \l__mriseq_k_sub_int }
          {
            \__mriseq_k_corner:nn
              { \l__mriseq_s_fp + ##1 / \l__mriseq_k_sub_int * \l__mriseq_ru_fp }
              { \l__mriseq_tmpa_fp * ##1 / \l__mriseq_k_sub_int }
          }
        \int_step_inline:nnn { 0 } { \l__mriseq_k_sub_int }
          {
            \__mriseq_k_corner:nn
              { \l__mriseq_s_fp + \l__mriseq_ru_fp + \l__mriseq_flat_fp + ##1 / \l__mriseq_k_sub_int * \l__mriseq_rd_fp }
              { \l__mriseq_tmpa_fp * ( 1 - ##1 / \l__mriseq_k_sub_int ) }
          }
        \seq_gput_right:Ne \g__mriseq_k_pieces_seq
          { { \l__mriseq_tmp_tl } { \exp_not:V \l__mriseq_path_tl } }
      }
  }
\int_new:N \l__mriseq_k_sub_int
\int_set:Nn \l__mriseq_k_sub_int { 5 }
\cs_new_protected:Npn \__mriseq_k_corner:nn #1#2
  {
    \tl_put_right:Ne \l__mriseq_path_tl { { \fp_eval:n {#1} } { \fp_eval:n {#2} } }
    \__mriseq_k_addtime:n {#1}
  }

%  smallest index i with T_i >= #1 - eps  (binary search)  -> \l__mriseq_tmpa_int
\int_new:N \l__mriseq_lo_int
\int_new:N \l__mriseq_hi_int
\int_new:N \l__mriseq_mid_int
\cs_new_protected:Npn \__mriseq_k_lower:n #1
  {
    \int_set:Nn \l__mriseq_lo_int { 1 }
    \int_set:Nn \l__mriseq_hi_int { \l__mriseq_k_n_int + 1 }
    \fp_set:Nn \l__mriseq_tmpc_fp { #1 - 1e-7 }
    \bool_do_while:nn { \int_compare_p:nNn \l__mriseq_lo_int < \l__mriseq_hi_int }
      {
        \int_set:Nn \l__mriseq_mid_int { \int_div_truncate:nn { \l__mriseq_lo_int + \l__mriseq_hi_int } { 2 } }
        \fp_compare:nNnTF { \__mriseq_kv:nn { T } { \int_use:N \l__mriseq_mid_int } } < \l__mriseq_tmpc_fp
          { \int_set:Nn \l__mriseq_lo_int { \l__mriseq_mid_int + 1 } }
          { \int_set:Nn \l__mriseq_hi_int { \l__mriseq_mid_int } }
      }
  }

%  add the piecewise-linear waveform #2 (list of {t}{g}) to axis #1
\cs_new_protected:Npn \__mriseq_k_addpiece:nn #1#2
  {
    \tl_set:Nn \l__mriseq_path_tl {#2}
    \int_set:Nn \l__mriseq_n_int { \tl_count:N \l__mriseq_path_tl / 2 }
    \int_step_inline:nn { \l__mriseq_n_int - 1 }
      {
        \fp_set:Nn \l__mriseq_s_fp { \tl_item:Nn \l__mriseq_path_tl { 2 * ##1 - 1 } }
        \fp_set:Nn \l__mriseq_amp_fp { \tl_item:Nn \l__mriseq_path_tl { 2 * ##1 } }
        \fp_set:Nn \l__mriseq_e_fp { \tl_item:Nn \l__mriseq_path_tl { 2 * ##1 + 1 } }
        \fp_set:Nn \l__mriseq_max_fp { \tl_item:Nn \l__mriseq_path_tl { 2 * ##1 + 2 } }
        \fp_compare:nNnT { \l__mriseq_e_fp - \l__mriseq_s_fp } > { 1e-9 }
          {
            \__mriseq_k_lower:n { \l__mriseq_s_fp }
            \int_set_eq:NN \l__mriseq_mid_int \l__mriseq_lo_int
            \bool_do_while:nn
              {
                \int_compare_p:nNn \l__mriseq_mid_int < { \l__mriseq_k_n_int + 1 }
                && \fp_compare_p:nNn { \__mriseq_kv:nn { T } { \int_use:N \l__mriseq_mid_int } }
                                     < { \l__mriseq_e_fp - 1e-7 }
              }
              {
                \__mriseq_kv_set:nen { G#1 } { \int_use:N \l__mriseq_mid_int }
                  {
                    \__mriseq_kv:nn { G#1 } { \int_use:N \l__mriseq_mid_int }
                    + \l__mriseq_amp_fp + ( \l__mriseq_max_fp - \l__mriseq_amp_fp )
                      * ( \__mriseq_kv:nn { T } { \int_use:N \l__mriseq_mid_int } - \l__mriseq_s_fp )
                      / ( \l__mriseq_e_fp - \l__mriseq_s_fp )
                  }
                \int_incr:N \l__mriseq_mid_int
              }
          }
      }
  }

\cs_new_protected:Npn \__mriseq_k_compute:
  {
    \seq_gclear:N \g__mriseq_k_pieces_seq
    \seq_gclear:N \g__mriseq_k_times_seq
    \seq_gclear:N \g__mriseq_k_events_seq
    \seq_gclear:N \g__mriseq_k_adc_seq
    \tl_gclear:N \g__mriseq_k_panel_tl
    \cs_set_eq:NN \__mriseq_item:nnn \__mriseq_k_collect:nnn
    \g__mriseq_items_tl
    \group_begin:
      % ---- sorted, unique time points
      \seq_set_eq:NN \l__mriseq_k_t_seq \g__mriseq_k_times_seq
      \seq_sort:Nn \l__mriseq_k_t_seq
        { \fp_compare:nNnTF {##1} > {##2} { \sort_return_swapped: } { \sort_return_same: } }
      \int_zero:N \l__mriseq_k_n_int
      \fp_set:Nn \l__mriseq_tmpb_fp { -inf }
      \seq_map_inline:Nn \l__mriseq_k_t_seq
        {
          \fp_compare:nNnT {##1} > { \l__mriseq_tmpb_fp + 1e-6 }
            {
              \int_incr:N \l__mriseq_k_n_int
              \__mriseq_kv_set:nen { T } { \int_use:N \l__mriseq_k_n_int } {##1}
              \__mriseq_kv_set:nen { Gx } { \int_use:N \l__mriseq_k_n_int } { 0 }
              \__mriseq_kv_set:nen { Gy } { \int_use:N \l__mriseq_k_n_int } { 0 }
              \__mriseq_kv_set:nen { Gz } { \int_use:N \l__mriseq_k_n_int } { 0 }
              \__mriseq_kv_set:nen { E } { \int_use:N \l__mriseq_k_n_int } { 0 }
              \fp_set:Nn \l__mriseq_tmpb_fp {##1}
            }
        }
      % ---- gradient values at the time points
      \seq_map_inline:Nn \g__mriseq_k_pieces_seq { \__mriseq_k_addpiece:nn ##1 }
      % ---- RF events
      \seq_map_inline:Nn \g__mriseq_k_events_seq { \__mriseq_k_event:nn ##1 }
      % ---- integrate
      \tl_clear:N \l__mriseq_q_mz_tl
      \tl_set:Nn \l__mriseq_k_px_tl { }
      \tl_set:Nn \l__mriseq_k_py_tl { }
      \tl_set:Nn \l__mriseq_k_pz_tl { }
      \fp_zero:N \l__mriseq_k_x_fp \fp_zero:N \l__mriseq_k_y_fp \fp_zero:N \l__mriseq_k_z_fp
      \fp_gzero:N \g__mriseq_k_maxx_fp \fp_gzero:N \g__mriseq_k_maxy_fp \fp_gzero:N \g__mriseq_k_maxz_fp
      \int_step_inline:nn { \l__mriseq_k_n_int }
        {
          \fp_set:Nn \l__mriseq_tmpa_fp { \__mriseq_kv:nn { T } {##1} }
          \int_compare:nNnF {##1} = { 1 }
            {
              \fp_set:Nn \l__mriseq_tmpb_fp
                { \c__mriseq_gamma_fp * ( \l__mriseq_tmpa_fp - \__mriseq_kv:nn { T } { ##1 - 1 } ) / 2 }
              \fp_set:Nn \l__mriseq_k_ox_fp { \l__mriseq_k_x_fp }
              \fp_set:Nn \l__mriseq_k_oy_fp { \l__mriseq_k_y_fp }
              \fp_add:Nn \l__mriseq_k_x_fp
                { \l__mriseq_tmpb_fp * ( \__mriseq_kv:nn { Gx } {##1} + \__mriseq_kv:nn { Gx } { ##1 - 1 } ) }
              \fp_add:Nn \l__mriseq_k_y_fp
                { \l__mriseq_tmpb_fp * ( \__mriseq_kv:nn { Gy } {##1} + \__mriseq_kv:nn { Gy } { ##1 - 1 } ) }
              \fp_add:Nn \l__mriseq_k_z_fp
                { \l__mriseq_tmpb_fp * ( \__mriseq_kv:nn { Gz } {##1} + \__mriseq_kv:nn { Gz } { ##1 - 1 } ) }
              \__mriseq_k_segment:nnn { \__mriseq_kv:nn { T } { ##1 - 1 } } { \l__mriseq_tmpa_fp } { line }
            }
          \__mriseq_k_point:
          \int_compare:nNnF { \__mriseq_kv:nn { E } {##1} } = { 0 }
            {
              \fp_set_eq:NN \l__mriseq_k_ox_fp \l__mriseq_k_x_fp
              \fp_set_eq:NN \l__mriseq_k_oy_fp \l__mriseq_k_y_fp
              \int_compare:nNnTF { \__mriseq_kv:nn { E } {##1} } = { 1 }
                { \fp_zero:N \l__mriseq_k_x_fp \fp_zero:N \l__mriseq_k_y_fp \fp_zero:N \l__mriseq_k_z_fp }
                {
                  \fp_set:Nn \l__mriseq_k_x_fp { - \l__mriseq_k_x_fp }
                  \fp_set:Nn \l__mriseq_k_y_fp { - \l__mriseq_k_y_fp }
                  \fp_set:Nn \l__mriseq_k_z_fp { - \l__mriseq_k_z_fp }
                }
              \int_compare:nNnF { \__mriseq_kv:nn { E } {##1} } = { 1 }
                { \__mriseq_k_segment:nnn { \l__mriseq_tmpa_fp } { \l__mriseq_tmpa_fp } { jump } }
              \__mriseq_k_point:
            }
        }
      % ---- k(t) rows as free waveforms
      \clist_map_inline:nn { x , y , z }
        {
          \tl_if_blank:vF { l__mriseq_k_p##1_tl }
            {
              \__mriseq_push:nne { wave } { k##1 }
                {
                  filled = false , occupy = false , group = k##1 ,
                  points = { \exp_not:v { l__mriseq_k_p##1_tl } }
                }
              \prop_gput:Nne \g__mriseq_max_prop { k##1 }
                { \fp_eval:n { max( \use:c { g__mriseq_k_max##1_fp } , 1e-9 ) } }
            }
        }
    \group_end:
  }
\fp_new:N \l__mriseq_k_x_fp
\fp_new:N \l__mriseq_k_y_fp
\fp_new:N \l__mriseq_k_z_fp
\fp_new:N \l__mriseq_k_ox_fp
\fp_new:N \l__mriseq_k_oy_fp
\tl_new:N \l__mriseq_k_px_tl
\tl_new:N \l__mriseq_k_py_tl
\tl_new:N \l__mriseq_k_pz_tl
\cs_generate_variant:Nn \prop_gput:Nnn { Nne }
\cs_new_protected:Npn \__mriseq_k_event:nn #1#2
  {
    \__mriseq_k_lower:n {#1}
    \int_compare:nNnT \l__mriseq_lo_int < { \l__mriseq_k_n_int + 1 }
      { \__mriseq_kv_set:nen { E } { \int_use:N \l__mriseq_lo_int } {#2} }
  }
\cs_new_protected:Npn \__mriseq_k_point:
  {
    \tl_put_right:Ne \l__mriseq_k_px_tl
      { \tl_if_blank:VF \l__mriseq_k_px_tl { , } \fp_eval:n { \l__mriseq_tmpa_fp } / \fp_eval:n { round( \l__mriseq_k_x_fp , 5 ) } }
    \tl_put_right:Ne \l__mriseq_k_py_tl
      { \tl_if_blank:VF \l__mriseq_k_py_tl { , } \fp_eval:n { \l__mriseq_tmpa_fp } / \fp_eval:n { round( \l__mriseq_k_y_fp , 5 ) } }
    \tl_put_right:Ne \l__mriseq_k_pz_tl
      { \tl_if_blank:VF \l__mriseq_k_pz_tl { , } \fp_eval:n { \l__mriseq_tmpa_fp } / \fp_eval:n { round( \l__mriseq_k_z_fp , 5 ) } }
    \fp_gset:Nn \g__mriseq_k_maxx_fp { max( \g__mriseq_k_maxx_fp , abs( \l__mriseq_k_x_fp ) ) }
    \fp_gset:Nn \g__mriseq_k_maxy_fp { max( \g__mriseq_k_maxy_fp , abs( \l__mriseq_k_y_fp ) ) }
    \fp_gset:Nn \g__mriseq_k_maxz_fp { max( \g__mriseq_k_maxz_fp , abs( \l__mriseq_k_z_fp ) ) }
  }
%  remember a segment of the 2-D trajectory (#1, #2 times; #3 line or jump)
\cs_new_protected:Npn \__mriseq_k_segment:nnn #1#2#3
  {
    \tl_set:Nn \l__mriseq_type_tl {#3}
    \str_if_eq:nnT {#3} { line }
      {
        \fp_set:Nn \l__mriseq_tmpc_fp { ( (#1) + (#2) ) / 2 }
        \seq_map_inline:Nn \g__mriseq_k_adc_seq
          {
            \fp_compare:nT { \use_i:nn ##1 - 1e-7 < \l__mriseq_tmpc_fp < \use_ii:nn ##1 + 1e-7 }
              { \tl_set:Nn \l__mriseq_type_tl { adc } \seq_map_break: }
          }
      }
    \bool_lazy_or:nnT
      { ! \fp_compare_p:nNn { abs( \l__mriseq_k_x_fp - \l__mriseq_k_ox_fp ) } < { 1e-9 } }
      { ! \fp_compare_p:nNn { abs( \l__mriseq_k_y_fp - \l__mriseq_k_oy_fp ) } < { 1e-9 } }
      {
        \tl_gput_right:Ne \g__mriseq_k_panel_tl
          {
            {
              { \l__mriseq_type_tl } { \fp_eval:n {#1} } { \fp_eval:n {#2} }
              { \fp_eval:n { \l__mriseq_k_ox_fp } } { \fp_eval:n { \l__mriseq_k_oy_fp } }
              { \fp_eval:n { \l__mriseq_k_x_fp } } { \fp_eval:n { \l__mriseq_k_y_fp } }
            }
          }
      }
  }

