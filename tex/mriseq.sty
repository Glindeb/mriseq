\cs_new_protected:Npn \__mriseq_q_common:
  {
    \fp_set:Nn \l__mriseq_q_gss_fp
      { \l__mriseq_p_tbw_fp / \l__mriseq_p_rfdur_fp * 1000 / ( \c__mriseq_gamma_fp * \l__mriseq_p_slice_fp ) }
    \fp_set:Nn \l__mriseq_q_gref_fp
      { \l__mriseq_p_tbw_fp / \l__mriseq_p_refdur_fp * 1000 / ( \c__mriseq_gamma_fp * \l__mriseq_p_slice_fp ) }
    \fp_set:Nn \l__mriseq_q_ginv_fp
      { \l__mriseq_p_tbw_fp / \l__mriseq_p_invdur_fp * 1000 / ( \c__mriseq_gamma_fp * \l__mriseq_p_slice_fp ) }
    \fp_set:Nn \l__mriseq_q_gro_fp
      { 1 / \l__mriseq_p_dwell_fp * 1000 / ( \c__mriseq_gamma_fp * \l__mriseq_p_fov_fp ) }
    \fp_set:Nn \l__mriseq_q_tacq_fp { \l__mriseq_p_nread_fp * \l__mriseq_p_dwell_fp }
    \fp_set:Nn \l__mriseq_q_ape_fp
      { \l__mriseq_p_nphase_fp / 2 * 1000 / ( \c__mriseq_gamma_fp * \l__mriseq_p_fov_fp ) }
    \fp_set:Nn \l__mriseq_q_sig_fp { 1 }
  }

%  resolve TE from the minimum value #1 (an fp expression)
\cs_new_protected:Npn \__mriseq_q_resolve_te:n #1
  {
    \fp_set:Nn \l__mriseq_q_temin_fp {#1}
    \str_if_eq:VnTF \l__mriseq_p_te_tl { auto }
      { \fp_set:Nn \l__mriseq_q_te_fp { ceil( \l__mriseq_q_temin_fp - 1e-6 ) } }
      {
        \fp_set:Nn \l__mriseq_q_te_fp { \l__mriseq_p_te_tl }
        \bool_lazy_and:nnT
          { \int_compare_p:nNn \l__mriseq_q_rep_int = { 0 } }
          { \fp_compare_p:nNn { \l__mriseq_q_te_fp } < { \l__mriseq_q_temin_fp - 1e-6 } }
          {
            \msg_warning:nneee { mriseq } { te-too-short } { TE }
              { \fp_eval:n { \l__mriseq_q_te_fp } }
              { \fp_eval:n { round( \l__mriseq_q_temin_fp , 2 ) } }
          }
      }
  }
\cs_generate_variant:Nn \msg_warning:nnnnn { nneee }

%  emit helpers ------------------------------------------------------------
\cs_new:Npn \__mriseq_f:n #1 { \fp_eval:n { round( #1 , 6 ) } }

\cs_new_protected:Npn \__mriseq_q_slice_grad:nnn #1#2#3
  % centre, flat, amp
  {
    \__mriseq_push:nne { grad } { gz }
      { center = \__mriseq_f:n {#1} , flat = \__mriseq_f:n {#2} ,
        ramp = \__mriseq_f:n { \l__mriseq_p_ramp_fp } , amp = \__mriseq_f:n {#3} ,
        split = \__mriseq_f:n {#1} }
  }
\cs_new_protected:Npn \__mriseq_q_lobe:nnn #1#2#3
  % row, start, area   (lobe fills the prephaser window)
  {
    \__mriseq_push:nne { grad } {#1}
      { start = \__mriseq_f:n {#2} ,
        flat = \__mriseq_f:n { \l__mriseq_p_prep_fp - 2 * \l__mriseq_p_ramp_fp } ,
        ramp = \__mriseq_f:n { \l__mriseq_p_ramp_fp } , area = \__mriseq_f:n {#3} }
  }
\cs_new_protected:Npn \__mriseq_q_ptable:nn #1#2
  { \__mriseq_q_ptable:nnV {#1} {#2} \l__mriseq_q_hl_tl }
\cs_new_protected:Npn \__mriseq_q_ptable:nnn #1#2#3
  % start, sign (1 encode, -1 rewind), highlight
  {
    \__mriseq_push:nne { ptable } { gy }
      {
        start = \__mriseq_f:n {#1} ,
        flat = \__mriseq_f:n { \l__mriseq_p_prep_fp - 2 * \l__mriseq_p_ramp_fp } ,
        ramp = \__mriseq_f:n { \l__mriseq_p_ramp_fp } , area = \__mriseq_f:n { \l__mriseq_q_ape_fp } ,
        lines = \l__mriseq_p_lines_tl ,
        arrow = \fp_compare:nNnTF {#2} > { 0 } { down } { up } ,
        \tl_if_blank:nF {#3}
          { highlight = \fp_eval:n { (#2) * (#3) } }
      }
  }
\cs_generate_variant:Nn \__mriseq_q_ptable:nnn { nnV }
\cs_new_protected:Npn \__mriseq_q_rf:nnnnn #1#2#3#4#5
  % centre, dur, flip, role, phase
  {
    \__mriseq_push:nne { rf } { rf }
      {
        center = \__mriseq_f:n {#1} , dur = \__mriseq_f:n {#2} , flip = #3 , role = #4 ,
        tbw = \__mriseq_f:n { \l__mriseq_p_tbw_fp } ,
        \bool_lazy_and:nnT { \str_if_eq_p:nn {#4} { excite } }
          { ! \tl_if_blank_p:V \l__mriseq_p_fliplabel_tl }
          { label = { \exp_not:V \l__mriseq_p_fliplabel_tl } , }
        \tl_if_blank:eF {#5} { phase = {#5} , }
      }
    \bool_if:NT \l__mriseq_p_pmarkers_bool
      { \__mriseq_push:nne { marker } { } { at = \__mriseq_f:n {#1} , kind = #4 } }
  }
\cs_new_protected:Npn \__mriseq_q_readout:nn #1#2
  % echo time, echo label
  {
    \__mriseq_push:nne { grad } { gx }
      { center = \__mriseq_f:n {#1} , flat = \__mriseq_f:n { \l__mriseq_q_tacq_fp } ,
        ramp = \__mriseq_f:n { \l__mriseq_p_ramp_fp } , amp = \__mriseq_f:n { \l__mriseq_q_gro_fp } ,
        split = \__mriseq_f:n {#1} }
    \__mriseq_push:nne { adc } { adc }
      { center = \__mriseq_f:n {#1} , samples = \fp_eval:n { \l__mriseq_p_nread_fp } ,
        dwell = \__mriseq_f:n { \l__mriseq_p_dwell_fp } , kzero = \__mriseq_f:n {#1} }
    \bool_if:NT \l__mriseq_p_emarker_bool
      {
        \__mriseq_push:nne { marker } { }
          { at = \__mriseq_f:n {#1} , kind = echo , label = { \exp_not:n {#2} } }
      }
  }
\cs_new_protected:Npn \__mriseq_q_interval:nnnn #1#2#3#4
  % key in annotate list, from, to, label
  {
    \clist_if_in:NnT \l__mriseq_p_annotate_clist {#1}
      {
        \int_incr:N \l__mriseq_q_level_int
        \__mriseq_q_interval_at:nnnnn {#1} { \int_use:N \l__mriseq_q_level_int } {#2} {#3} {#4}
      }
  }
\cs_new_protected:Npn \__mriseq_q_interval_at:nnnnn #1#2#3#4#5
  % key, level, from, to, label
  {
        \__mriseq_push:nne { interval } { }
          {
            from = \__mriseq_f:n {#3} , to = \__mriseq_f:n {#4} ,
            level = #2 ,
            label =
              {
                \exp_not:n {#5}
                \bool_if:NT \l__mriseq_amplabels_bool
                  { \exp_not:N \, = \exp_not:N \, \__mriseq_num:n { (#4) - (#3) } \exp_not:N \, ms }
              }
          }
  }

% ---- Mz evolution ---------------------------------------------------------
%  events: clist of  time/flip  ;  #2 = end time
\cs_new_protected:Npn \__mriseq_q_mz:nn #1#2
  { \clist_if_in:NnT \l__mriseq_rows_clist { mz } { \__mriseq_q_mz_do:nn {#1} {#2} } }
\cs_new_protected:Npn \__mriseq_q_mz_do:nn #1#2
  {
    \tl_clear:N \l__mriseq_q_mz_tl
    \fp_set:Nn \l__mriseq_tmpa_fp { 1 }                 % current Mz
    \fp_set:Nn \l__mriseq_tmpb_fp { \l__mriseq_p_lead_fp - 0.3 } % current time
    \tl_put_right:Ne \l__mriseq_q_mz_tl { \__mriseq_f:n { \l__mriseq_tmpb_fp } / 1 }
    \tl_set:Ne \l__mriseq_tmp_tl {#1}
    \exp_args:NV \clist_map_inline:nn \l__mriseq_tmp_tl { \__mriseq_q_mz_event:w ##1 \q_stop }
    \__mriseq_q_mz_segment:n {#2}
    \__mriseq_push:nne { wave } { mz }
      { filled = false , occupy = false , group = mz , points = { \exp_not:V \l__mriseq_q_mz_tl } }
  }
\cs_new_protected:Npn \__mriseq_q_mz_segment:n #1
  {
    \int_step_inline:nn { 24 }
      {
        \fp_set:Nn \l__mriseq_tmpc_fp
          { \l__mriseq_tmpb_fp + ##1 / 24 * ( (#1) - \l__mriseq_tmpb_fp ) }
        \tl_put_right:Ne \l__mriseq_q_mz_tl
          {
            , \__mriseq_f:n { \l__mriseq_tmpc_fp } /
            \__mriseq_f:n { 1 - ( 1 - \l__mriseq_tmpa_fp )
                            * exp( - ( \l__mriseq_tmpc_fp - \l__mriseq_tmpb_fp ) / \l__mriseq_p_tone_fp ) }
          }
      }
    \fp_set:Nn \l__mriseq_tmpa_fp
      { 1 - ( 1 - \l__mriseq_tmpa_fp ) * exp( - ( (#1) - \l__mriseq_tmpb_fp ) / \l__mriseq_p_tone_fp ) }
    \fp_set:Nn \l__mriseq_tmpb_fp {#1}
  }
\cs_new_protected:Npn \__mriseq_q_mz_event:w #1 / #2 \q_stop
  {
    \__mriseq_q_mz_segment:n {#1}
    \fp_set:Nn \l__mriseq_tmpa_fp { \l__mriseq_tmpa_fp * cosd(#2) }
    \tl_put_right:Ne \l__mriseq_q_mz_tl
      { , \__mriseq_f:n {#1} / \__mriseq_f:n { \l__mriseq_tmpa_fp } }
  }

% ---- refocusing pulse with slice gradient and crushers ------------------
\cs_new_protected:Npn \__mriseq_q_crushers:n #1
  {
    \bool_if:NT \l__mriseq_p_crushers_bool
      {
        \__mriseq_push:nne { grad } { gz }
          { end = \__mriseq_f:n { #1 - \l__mriseq_p_refdur_fp / 2 - \l__mriseq_p_ramp_fp } ,
            dur = \__mriseq_f:n { \l__mriseq_p_crushdur_fp } , ramp = \__mriseq_f:n { \l__mriseq_p_ramp_fp } ,
            amp = \__mriseq_f:n { \l__mriseq_q_gref_fp } , amp~labels = false , area~labels = false }
        \__mriseq_push:nne { grad } { gz }
          { start = \__mriseq_f:n { #1 + \l__mriseq_p_refdur_fp / 2 + \l__mriseq_p_ramp_fp } ,
            dur = \__mriseq_f:n { \l__mriseq_p_crushdur_fp } , ramp = \__mriseq_f:n { \l__mriseq_p_ramp_fp } ,
            amp = \__mriseq_f:n { \l__mriseq_q_gref_fp } , amp~labels = false , area~labels = false }
      }
  }
\cs_new_protected:Npn \__mriseq_q_refocus:n #1
  {
    \__mriseq_q_rf:nnnnn {#1} { \l__mriseq_p_refdur_fp } { 180 } { refocus }
      { \l__mriseq_p_refphase_tl }
    \__mriseq_q_slice_grad:nnn {#1} { \l__mriseq_p_refdur_fp } { \l__mriseq_q_gref_fp }
    \__mriseq_q_crushers:n {#1}
    \__mriseq_q_event:nn {#1} { 180 }
  }
\cs_new_protected:Npn \__mriseq_q_event:nn #1#2
  { \tl_put_right:Ne \l__mriseq_q_events_tl { , \__mriseq_f:n {#1} / \fp_eval:n {#2} } }
\cs_new_protected:Npn \__mriseq_q_end:n #1
  { \fp_set:Nn \l__mriseq_q_end_fp { max( \l__mriseq_q_end_fp , #1 ) } }
\cs_new:Npn \__mriseq_q_flip:n #1
  { \tl_if_blank:VTF \l__mriseq_p_flip_tl {#1} { \l__mriseq_p_flip_tl } }
\cs_new_protected:Npn \__mriseq_q_excite:n #1
  % excitation pulse with slice gradient at #1 (default flip #2 in \l__mriseq_q_dflip_tl)
  {
    \__mriseq_q_rf:nnnnn {#1} { \l__mriseq_p_rfdur_fp }
      { \__mriseq_q_flip:n { \l__mriseq_q_dflip_tl } } { excite } { \l__mriseq_p_excphase_tl }
    \__mriseq_q_slice_grad:nnn {#1} { \l__mriseq_p_rfdur_fp } { \l__mriseq_q_gss_fp }
    \__mriseq_q_event:nn {#1} { \__mriseq_q_flip:n { \l__mriseq_q_dflip_tl } }
  }
\tl_new:N \l__mriseq_q_dflip_tl

% ---- diffusion weighting (Stejskal-Tanner, trapezoidal lobes) ------------
%  b(delta) = gamma^2 G^2 [ delta^2 (Delta - delta/3) + eps^3/30 - delta eps^2/6 ]
%  with Delta = delta + c, delta = flat + eps, solved for delta by bisection.
\cs_new:Npn \__mriseq_q_bvalue:n #1
  {
    ( 2 * pi * 42.577478518e6 ) ^ 2 * ( \l__mriseq_p_damp_fp * 1e-3 ) ^ 2
    * ( ( (#1) * 1e-3 ) ^ 2 * ( ( (#1) + \l__mriseq_tmpc_fp ) * 1e-3 - (#1) * 1e-3 / 3 )
        + ( \l__mriseq_p_dramp_fp * 1e-3 ) ^ 3 / 30
        - (#1) * 1e-3 * ( \l__mriseq_p_dramp_fp * 1e-3 ) ^ 2 / 6 ) * 1e-6
  }
\cs_new_protected:Npn \__mriseq_q_diff_prepare:
  {
    \fp_compare:nNnTF \l__mriseq_p_b_fp > { 0 }
      {
        % c = Delta - delta  (lobes placed right next to the refocusing block)
        \fp_set:Nn \l__mriseq_tmpc_fp
          { \l__mriseq_p_dramp_fp + \l__mriseq_p_refdur_fp + 2 * \l__mriseq_p_ramp_fp + 2 * \l__mriseq_q_x_fp }
        \fp_set:Nn \l__mriseq_tmpa_fp { \l__mriseq_p_dramp_fp }
        \fp_set:Nn \l__mriseq_tmpb_fp { 1000 }
        \prg_replicate:nn { 45 }
          {
            \fp_compare:nNnTF
              { \__mriseq_q_bvalue:n { ( \l__mriseq_tmpa_fp + \l__mriseq_tmpb_fp ) / 2 } }
              < \l__mriseq_p_b_fp
              { \fp_set:Nn \l__mriseq_tmpa_fp { ( \l__mriseq_tmpa_fp + \l__mriseq_tmpb_fp ) / 2 } }
              { \fp_set:Nn \l__mriseq_tmpb_fp { ( \l__mriseq_tmpa_fp + \l__mriseq_tmpb_fp ) / 2 } }
          }
        \fp_set:Nn \l__mriseq_q_dflat_fp { max( 0 , \l__mriseq_tmpb_fp - \l__mriseq_p_dramp_fp ) }
        \fp_set:Nn \l__mriseq_q_dl_fp { \l__mriseq_q_dflat_fp + 2 * \l__mriseq_p_dramp_fp }
      }
      { \fp_zero:N \l__mriseq_q_dl_fp }
  }
\cs_new_protected:Npn \__mriseq_q_diff_lobes:n #1
  % #1 = centre of the refocusing pulse
  {
    \fp_compare:nNnT \l__mriseq_p_b_fp > { 0 }
      {
        \fp_set:Nn \l__mriseq_tmpa_fp
          { #1 - \l__mriseq_p_refdur_fp / 2 - \l__mriseq_p_ramp_fp - \l__mriseq_q_x_fp - \l__mriseq_q_dl_fp }
        \fp_set:Nn \l__mriseq_tmpb_fp
          { #1 + \l__mriseq_p_refdur_fp / 2 + \l__mriseq_p_ramp_fp + \l__mriseq_q_x_fp }
        \int_compare:nNnT \l__mriseq_q_rep_int = { 0 }
          {
            \fp_set_eq:NN \l__mriseq_q_dstart_fp \l__mriseq_tmpa_fp
            \fp_set:Nn \l__mriseq_q_dsep_fp { \l__mriseq_tmpb_fp - \l__mriseq_tmpa_fp }
          }
        \clist_map_inline:Nn \l__mriseq_p_daxis_clist
          {
            \__mriseq_push:nne { grad } {##1}
              {
                start = \__mriseq_f:n { \l__mriseq_tmpa_fp } , flat = \__mriseq_f:n { \l__mriseq_q_dflat_fp } ,
                ramp = \__mriseq_f:n { \l__mriseq_p_dramp_fp } ,
                amp = \__mriseq_f:n { \l__mriseq_p_damp_fp / sqrt( \clist_count:N \l__mriseq_p_daxis_clist ) } ,
                area~labels = false
              }
            \__mriseq_push:nne { grad } {##1}
              {
                start = \__mriseq_f:n { \l__mriseq_tmpb_fp } , flat = \__mriseq_f:n { \l__mriseq_q_dflat_fp } ,
                ramp = \__mriseq_f:n { \l__mriseq_p_dramp_fp } ,
                amp = \__mriseq_f:n { \l__mriseq_p_damp_fp / sqrt( \clist_count:N \l__mriseq_p_daxis_clist ) } ,
                area~labels = false , amp~labels = false
              }
          }
      }
  }
\cs_new_protected:Npn \__mriseq_q_diff_intervals:
  {
    \fp_compare:nNnT \l__mriseq_p_b_fp > { 0 }
      {
        \tl_set:Ne \l__mriseq_tmp_tl { \clist_item:Nn \l__mriseq_p_daxis_clist { 1 } }
        \clist_if_in:NnT \l__mriseq_p_annotate_clist { Delta }
          {
            \__mriseq_push:nne { interval } { }
              {
                from = \__mriseq_f:n { \l__mriseq_q_dstart_fp } ,
                to = \__mriseq_f:n { \l__mriseq_q_dstart_fp + \l__mriseq_q_dsep_fp } ,
                pos = \l__mriseq_tmp_tl , height = 0.07 , guides = false ,
                label = { \exp_not:V \l__mriseq_p_Deltalabel_tl
                          \bool_if:NT \l__mriseq_amplabels_bool
                            { \exp_not:N \, = \exp_not:N \, \__mriseq_num:n { \l__mriseq_q_dsep_fp } \exp_not:N \, ms } }
              }
          }
        \clist_if_in:NnT \l__mriseq_p_annotate_clist { delta }
          {
            \__mriseq_push:nne { interval } { }
              {
                from = \__mriseq_f:n { \l__mriseq_q_dstart_fp } ,
                to = \__mriseq_f:n { \l__mriseq_q_dstart_fp + \l__mriseq_q_dflat_fp + \l__mriseq_p_dramp_fp } ,
                pos = \l__mriseq_tmp_tl , height = 0.33 , guides = false ,
                label = { \exp_not:V \l__mriseq_p_deltalabel_tl
                          \bool_if:NT \l__mriseq_amplabels_bool
                            { \exp_not:N \, = \exp_not:N \, \__mriseq_num:n
                                { \l__mriseq_q_dflat_fp + \l__mriseq_p_dramp_fp } \exp_not:N \, ms } }
              }
          }
      }
  }

% ---- spin-echo module -----------------------------------------------------
%  #1 = excitation centre.  Returns nothing; sets \l__mriseq_q_techo_fp.
\cs_new_protected:Npn \__mriseq_q_se_module:n #1
  {
    \fp_set:Nn \l__mriseq_q_t_fp {#1}
    \fp_set:Nn \l__mriseq_q_x_fp
      { \bool_if:NTF \l__mriseq_p_crushers_bool { \l__mriseq_p_crushdur_fp } { 0 } }
    \__mriseq_q_diff_prepare:
    \__mriseq_q_resolve_te:n
      {
        2 * max(
          \l__mriseq_p_rfdur_fp / 2 + \l__mriseq_p_ramp_fp + \l__mriseq_p_prep_fp
            + \l__mriseq_q_x_fp + \l__mriseq_p_ramp_fp + \l__mriseq_p_refdur_fp / 2 + \l__mriseq_q_dl_fp ,
          \l__mriseq_p_refdur_fp / 2 + \l__mriseq_p_ramp_fp + \l__mriseq_q_x_fp
            + \l__mriseq_p_ramp_fp + \l__mriseq_q_tacq_fp / 2 + \l__mriseq_q_dl_fp )
      }
    \fp_set:Nn \l__mriseq_q_tref_fp { \l__mriseq_q_t_fp + \l__mriseq_q_te_fp / 2 }
    \fp_set:Nn \l__mriseq_q_techo_fp { \l__mriseq_q_t_fp + \l__mriseq_q_te_fp }
    \fp_set:Nn \l__mriseq_q_p_fp
      { \l__mriseq_q_t_fp + \l__mriseq_p_rfdur_fp / 2 + \l__mriseq_p_ramp_fp }
    % excitation
    \__mriseq_q_excite:n { \l__mriseq_q_t_fp }
    % prephasers
    \__mriseq_q_lobe:nnn { gz } { \l__mriseq_q_p_fp }
      { - \l__mriseq_q_gss_fp * ( \l__mriseq_p_rfdur_fp / 2 + \l__mriseq_p_ramp_fp / 2 ) }
    \__mriseq_q_ptable:nn { \l__mriseq_q_p_fp } { 1 }
    \__mriseq_q_lobe:nnn { gx } { \l__mriseq_q_p_fp }
      { \l__mriseq_q_gro_fp * ( \l__mriseq_q_tacq_fp / 2 + \l__mriseq_p_ramp_fp / 2 ) }
    % refocusing
    \__mriseq_q_refocus:n { \l__mriseq_q_tref_fp }
    \__mriseq_q_diff_lobes:n { \l__mriseq_q_tref_fp }
    % readout
    \__mriseq_q_readout:nn { \l__mriseq_q_techo_fp }
      { \tl_if_blank:VTF \l__mriseq_p_echolabel_tl { SE } { \l__mriseq_p_echolabel_tl } }
    % signal
    \bool_if:NT \l__mriseq_p_signal_bool
      {
        \__mriseq_push:nne { fid } { sig }
          {
            start = \__mriseq_f:n { \l__mriseq_q_t_fp + \l__mriseq_p_rfdur_fp / 2 } ,
            t2 = \__mriseq_f:n { \l__mriseq_p_fidtwo_fp } , cycles = 2 ,
            dur = \__mriseq_f:n { min( 5 * \l__mriseq_p_fidtwo_fp ,
                    \l__mriseq_q_tref_fp - \l__mriseq_p_refdur_fp / 2 - \l__mriseq_q_t_fp - \l__mriseq_p_rfdur_fp / 2 ) } ,
            amp = \__mriseq_f:n { \l__mriseq_q_sig_fp
                    * sind( \tl_if_blank:VTF \l__mriseq_p_flip_tl { 90 } { \l__mriseq_p_flip_tl } ) }
          }
        \__mriseq_push:nne { echo } { sig }
          {
            center = \__mriseq_f:n { \l__mriseq_q_techo_fp } ,
            t2 = \__mriseq_f:n { \l__mriseq_q_tacq_fp / 7 } , cycles = 1.5 ,
            dur = \__mriseq_f:n { \l__mriseq_q_tacq_fp * 1.1 } ,
            amp = \__mriseq_f:n { \l__mriseq_q_sig_fp
                    * sind( \tl_if_blank:VTF \l__mriseq_p_flip_tl { 90 } { \l__mriseq_p_flip_tl } )
                    * exp( - \l__mriseq_q_te_fp / \l__mriseq_p_ttwo_fp
                           - \l__mriseq_p_b_fp * \l__mriseq_p_diffusivity_fp ) }
          }
      }
    \__mriseq_q_equal_areas:
    \__mriseq_q_end:n
      { \l__mriseq_q_techo_fp + \l__mriseq_q_tacq_fp / 2 + \l__mriseq_p_ramp_fp + 0.2 }
  }

% ---- gradient-echo module --------------------------------------------------
\cs_new_protected:Npn \__mriseq_q_gre_module:n #1
  {
    \fp_set:Nn \l__mriseq_q_t_fp {#1}
    \__mriseq_q_resolve_te:n
      {
        \l__mriseq_p_rfdur_fp / 2 + \l__mriseq_p_ramp_fp + \l__mriseq_p_prep_fp
          + \l__mriseq_p_ramp_fp + \l__mriseq_q_tacq_fp / 2
      }
    \fp_set:Nn \l__mriseq_q_techo_fp { \l__mriseq_q_t_fp + \l__mriseq_q_te_fp }
    \fp_set:Nn \l__mriseq_q_p_fp
      { \l__mriseq_q_t_fp + \l__mriseq_p_rfdur_fp / 2 + \l__mriseq_p_ramp_fp }
    \__mriseq_q_excite:n { \l__mriseq_q_t_fp }
    \__mriseq_q_lobe:nnn { gz } { \l__mriseq_q_p_fp }
      { - \l__mriseq_q_gss_fp * ( \l__mriseq_p_rfdur_fp / 2 + \l__mriseq_p_ramp_fp / 2 ) }
    \__mriseq_q_ptable:nn { \l__mriseq_q_p_fp } { 1 }
    \__mriseq_q_lobe:nnn { gx } { \l__mriseq_q_p_fp }
      { - \l__mriseq_q_gro_fp * ( \l__mriseq_q_tacq_fp / 2 + \l__mriseq_p_ramp_fp / 2 ) }
    \__mriseq_q_readout:nn { \l__mriseq_q_techo_fp }
      { \tl_if_blank:VTF \l__mriseq_p_echolabel_tl { GE } { \l__mriseq_p_echolabel_tl } }
    \fp_set:Nn \l__mriseq_q_x_fp
      { \l__mriseq_q_techo_fp + \l__mriseq_q_tacq_fp / 2 + \l__mriseq_p_ramp_fp }
    \bool_if:NT \l__mriseq_p_rewinder_bool
      { \__mriseq_q_ptable:nn { \l__mriseq_q_x_fp } { -1 } }
    \bool_if:NT \l__mriseq_p_spoiler_bool
      {
        \__mriseq_push:nne { grad } { gz }
          { start = \__mriseq_f:n { \l__mriseq_q_x_fp } ,
            dur = \__mriseq_f:n { \l__mriseq_p_spoildur_fp } , ramp = \__mriseq_f:n { \l__mriseq_p_ramp_fp } ,
            amp = \__mriseq_f:n { \l__mriseq_q_gss_fp } }
      }
    \bool_if:NT \l__mriseq_p_signal_bool
      {
        \__mriseq_push:nne { fid } { sig }
          {
            start = \__mriseq_f:n { \l__mriseq_q_t_fp + \l__mriseq_p_rfdur_fp / 2 } ,
            t2 = \__mriseq_f:n { \l__mriseq_p_fidtwo_fp } , cycles = 2 ,
            dur = \__mriseq_f:n { min( 5 * \l__mriseq_p_fidtwo_fp ,
                    \l__mriseq_q_p_fp + \l__mriseq_p_prep_fp - \l__mriseq_q_t_fp - \l__mriseq_p_rfdur_fp / 2 ) } ,
            amp = \__mriseq_f:n { \l__mriseq_q_sig_fp * sind( \tl_if_blank:VTF \l__mriseq_p_flip_tl { 30 } { \l__mriseq_p_flip_tl } ) }
          }
        \__mriseq_push:nne { echo } { sig }
          {
            center = \__mriseq_f:n { \l__mriseq_q_techo_fp } ,
            t2 = \__mriseq_f:n { \l__mriseq_q_tacq_fp / 7 } , cycles = 1.5 ,
            dur = \__mriseq_f:n { \l__mriseq_q_tacq_fp * 1.1 } ,
            amp = \__mriseq_f:n { \l__mriseq_q_sig_fp
                    * sind( \tl_if_blank:VTF \l__mriseq_p_flip_tl { 30 } { \l__mriseq_p_flip_tl } )
                    * exp( - \l__mriseq_q_te_fp / \l__mriseq_p_ttwostar_fp ) }
          }
      }
    \__mriseq_q_equal_areas:
    \__mriseq_q_end:n
      {
        \l__mriseq_q_x_fp + 0.2 + max( \bool_if:NTF \l__mriseq_p_spoiler_bool { \l__mriseq_p_spoildur_fp } { 0 } ,
                                         \bool_if:NTF \l__mriseq_p_rewinder_bool { \l__mriseq_p_prep_fp } { 0 } )
      }
  }

% ---- EPI module ----------------------------------------------------------
\fp_new:N \l__mriseq_q_esp_fp
\fp_new:N \l__mriseq_q_ts_fp
\fp_new:N \l__mriseq_q_tc_fp
\int_new:N \l__mriseq_q_ny_int
\int_new:N \l__mriseq_q_nc_int
\int_new:N \l__mriseq_q_shot_int
\fp_new:N \l__mriseq_q_line_fp
\cs_new_protected:Npn \__mriseq_q_epi_module:n #1
  {
    \fp_set:Nn \l__mriseq_q_t_fp {#1}
    \fp_set:Nn \l__mriseq_q_esp_fp { \l__mriseq_q_tacq_fp + 2 * \l__mriseq_p_ramp_fp }
    % lines per shot (segmented EPI), shot index of this repetition
    \int_set:Nn \l__mriseq_q_ny_int
      { \int_div_truncate:nn { \fp_eval:n { round( \l__mriseq_p_nphase_fp ) } } { \l__mriseq_p_shots_int } }
    \int_set:Nn \l__mriseq_q_nc_int { \int_div_truncate:nn { \l__mriseq_q_ny_int } { 2 } }
    \int_set:Nn \l__mriseq_q_shot_int
      { \int_mod:nn { \l__mriseq_q_rep_int } { \l__mriseq_p_shots_int } }
    \fp_set:Nn \l__mriseq_q_line_fp { 2 * \l__mriseq_q_ape_fp / \l__mriseq_p_nphase_fp }
    \fp_compare:nNnT \l__mriseq_p_b_fp > { 0 } { \bool_set_true:N \l__mriseq_p_refocusing_bool }
    % time from the start of the echo train to the centre of k-space
    \fp_set:Nn \l__mriseq_q_tc_fp
      { ( \int_use:N \l__mriseq_q_nc_int + 0.5 ) * \l__mriseq_q_esp_fp }
    \fp_set:Nn \l__mriseq_q_x_fp
      { \bool_if:NTF \l__mriseq_p_crushers_bool { \l__mriseq_p_crushdur_fp } { 0 } }
    \fp_set:Nn \l__mriseq_q_p_fp
      { \l__mriseq_q_t_fp + \l__mriseq_p_rfdur_fp / 2 + \l__mriseq_p_ramp_fp }
    \bool_if:NTF \l__mriseq_p_refocusing_bool
      {
        \__mriseq_q_diff_prepare:
        \__mriseq_q_resolve_te:n
          {
            2 * max(
              \l__mriseq_p_rfdur_fp / 2 + \l__mriseq_p_ramp_fp + \l__mriseq_p_prep_fp
                + \l__mriseq_q_x_fp + \l__mriseq_p_ramp_fp + \l__mriseq_p_refdur_fp / 2 + \l__mriseq_q_dl_fp ,
              \l__mriseq_p_refdur_fp / 2 + \l__mriseq_p_ramp_fp + \l__mriseq_q_x_fp
                + \l__mriseq_q_dl_fp + \l__mriseq_p_prep_fp + \l__mriseq_q_tc_fp )
          }
      }
      {
        \__mriseq_q_resolve_te:n
          { \l__mriseq_p_rfdur_fp / 2 + \l__mriseq_p_ramp_fp + \l__mriseq_p_prep_fp + \l__mriseq_q_tc_fp }
      }
    \fp_set:Nn \l__mriseq_q_techo_fp { \l__mriseq_q_t_fp + \l__mriseq_q_te_fp }
    \fp_set:Nn \l__mriseq_q_ts_fp { \l__mriseq_q_techo_fp - \l__mriseq_q_tc_fp }
    % excitation and slice rephaser
    \__mriseq_q_excite:n { \l__mriseq_q_t_fp }
    \__mriseq_q_lobe:nnn { gz } { \l__mriseq_q_p_fp }
      { - \l__mriseq_q_gss_fp * ( \l__mriseq_p_rfdur_fp / 2 + \l__mriseq_p_ramp_fp / 2 ) }
    \bool_if:NT \l__mriseq_p_refocusing_bool
      {
        \fp_set:Nn \l__mriseq_q_tref_fp { \l__mriseq_q_t_fp + \l__mriseq_q_te_fp / 2 }
        \__mriseq_q_refocus:n { \l__mriseq_q_tref_fp }
        \__mriseq_q_diff_lobes:n { \l__mriseq_q_tref_fp }
      }
    % prephasers to the corner of k-space, just before the train
    \__mriseq_q_lobe:nnn { gx } { \l__mriseq_q_ts_fp - \l__mriseq_p_prep_fp }
      { - \l__mriseq_q_gro_fp * ( \l__mriseq_q_tacq_fp / 2 + \l__mriseq_p_ramp_fp / 2 ) }
    \__mriseq_q_lobe:nnn { gy } { \l__mriseq_q_ts_fp - \l__mriseq_p_prep_fp }
      { - \l__mriseq_q_ape_fp + \l__mriseq_q_shot_int * \l__mriseq_q_line_fp }
    % echo train
    \int_step_inline:nnn { 0 } { \l__mriseq_q_ny_int - 1 }
      {
        \fp_set:Nn \l__mriseq_tmpa_fp { \l__mriseq_q_ts_fp + ##1 * \l__mriseq_q_esp_fp }
        \__mriseq_push:nne { grad } { gx }
          {
            start = \__mriseq_f:n { \l__mriseq_tmpa_fp } ,
            flat = \__mriseq_f:n { \l__mriseq_q_tacq_fp } ,
            ramp = \__mriseq_f:n { \l__mriseq_p_ramp_fp } ,
            amp = \int_if_odd:nT {##1} { - } \__mriseq_f:n { \l__mriseq_q_gro_fp } ,
            area~labels = false
            \int_compare:nNnF {##1} = { 0 } { , values = false }
          }
        \__mriseq_push:nne { adc } { adc }
          {
            start = \__mriseq_f:n { \l__mriseq_tmpa_fp + \l__mriseq_p_ramp_fp } ,
            dur = \__mriseq_f:n { \l__mriseq_q_tacq_fp } ,
            samples = \fp_eval:n { \l__mriseq_p_nread_fp } ,
            dwell = \__mriseq_f:n { \l__mriseq_p_dwell_fp } ,
            sample~ticks = false , adc~labels = false
            \int_compare:nNnT {##1} = { \l__mriseq_q_nc_int }
              { , kzero = \__mriseq_f:n { \l__mriseq_q_techo_fp } }
          }
