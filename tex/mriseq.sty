\fp_new:N \l__mriseq_kp_x_fp
\fp_new:N \l__mriseq_kp_y_fp
\fp_new:N \l__mriseq_kp_s_fp
\fp_new:N \l__mriseq_kp_m_fp
\fp_new:N \l__mriseq_kp_my_fp
