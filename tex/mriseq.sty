% =========================================================================
%  3. Rows
% =========================================================================
\tl_new:N \l__mriseq_rowname_tl
\cs_new_protected:Npn \__mriseq_row_ensure:n #1
  {
    \tl_if_exist:cF { l__mriseq_row_#1_label_tl }
      {
        \tl_new:c { l__mriseq_row_#1_label_tl }
        \tl_new:c { l__mriseq_row_#1_sub_tl }
        \tl_new:c { l__mriseq_row_#1_height_tl }
        \tl_new:c { l__mriseq_row_#1_base_tl }
        \tl_new:c { l__mriseq_row_#1_group_tl }
        \tl_new:c { l__mriseq_row_#1_yb_tl }
        \tl_new:c { l__mriseq_row_#1_sc_tl }
        \tl_new:c { l__mriseq_row_#1_ytop_tl }
        \tl_new:c { l__mriseq_row_#1_ybot_tl }
        \tl_set:cn { l__mriseq_row_#1_label_tl } {#1}
        \tl_set:cn { l__mriseq_row_#1_height_tl } { 1.2cm }
        \tl_set:cn { l__mriseq_row_#1_base_tl } { 0.5 }
        \tl_set:cn { l__mriseq_row_#1_group_tl } {#1}
      }
  }
\keys_define:nn { mriseq / row }
  {
    label    .code:n = \tl_set:cn { l__mriseq_row_ \l__mriseq_rowname_tl _label_tl } {#1} ,
    sublabel .code:n = \tl_set:cn { l__mriseq_row_ \l__mriseq_rowname_tl _sub_tl } {#1} ,
    height   .code:n = \tl_set:cn { l__mriseq_row_ \l__mriseq_rowname_tl _height_tl } {#1} ,
    baseline .code:n = \tl_set:cn { l__mriseq_row_ \l__mriseq_rowname_tl _base_tl } {#1} ,
    group    .code:n = \tl_set:cn { l__mriseq_row_ \l__mriseq_rowname_tl _group_tl } {#1} ,
  }
\NewDocumentCommand \mriseqdefinerow { m m }
  {
    \tl_set:Ne \l__mriseq_rowname_tl { \tl_trim_spaces:n {#1} }
    \__mriseq_row_ensure:V \l__mriseq_rowname_tl
    \keys_set:nn { mriseq / row } {#2}
  }
\cs_generate_variant:Nn \__mriseq_row_ensure:n { V , e }
\cs_new_eq:NN \mriseqrow \mriseqdefinerow

