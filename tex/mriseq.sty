\cs_new_protected:Npn \__mriseq_parse_time:n #1
  {
    \seq_set_split:Nee \l__mriseq_tmp_seq { \c_colon_str } { \tl_to_str:n {#1} }
    \tl_set:Ne \l__mriseq_tmin_tl { \seq_item:Nn \l__mriseq_tmp_seq { 1 } }
    \tl_set:Ne \l__mriseq_tmax_tl { \seq_item:Nn \l__mriseq_tmp_seq { 2 } }
  }
