\cs_new:Npn \__mriseq_shape_sinc:n #1
  {
    ( sin( pi * \l__mriseq_tbw_fp * (#1) + 1e-12 ) / ( pi * \l__mriseq_tbw_fp * (#1) + 1e-12 ) )
    * \__mriseq_window:n {#1}
  }
\cs_new:Npn \__mriseq_shape_gauss:n #1 { exp( -0.5 * ( (#1) / 0.17 ) ^ 2 ) }
\cs_new:Npn \__mriseq_shape_sech:n #1
  { 2 / ( exp( 10 * (#1) ) + exp( -10 * (#1) ) ) }
