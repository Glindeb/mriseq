                { \dim_to_decimal_in_unit:nn { \l__mriseq_cs_y_tl } { 1cm } }
            }
        }
        { \__mriseq_use_row:V \l__mriseq_cs_row_tl }
      \tl_set:Ne \l__mriseq_tmp_tl
        {
          \exp_not:N \pgfpoint
            { \__mriseq_x:n { \l__mriseq_cs_t_tl } cm }
            { \__mriseq_y:n { \l__mriseq_cs_a_tl } cm }
        }
    \exp_args:NNNV \group_end:
